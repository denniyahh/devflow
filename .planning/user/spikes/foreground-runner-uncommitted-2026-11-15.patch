+++ b/crates/devflow-core/src/monitor.rs
@@ -2199,6 +2199,18 @@ fn spawn_stage_agent(
             Some(capture)
         }
     };
+    // SPIKE (throwaway): the kernel kills the agent when this process dies.
+    if std::env::var_os("DEVFLOW_SPIKE_PDEATHSIG").is_some() {
+        // SAFETY: prctl is async-signal-safe and touches only the child.
+        unsafe {
+            agent_cmd.pre_exec(|| {
+                if libc::prctl(libc::PR_SET_PDEATHSIG, libc::SIGKILL) != 0 {
+                    return Err(std::io::Error::last_os_error());
+                }
+                Ok(())
+            });
+        }
+    }
     Ok((agent_cmd.spawn()?, stream_capture))
 }
 
