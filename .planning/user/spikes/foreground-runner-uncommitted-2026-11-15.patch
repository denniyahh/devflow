--- a/crates/devflow-cli/src/pipeline_launch.rs
+++ b/crates/devflow-cli/src/pipeline_launch.rs
@@ -2161,6 +2161,73 @@ fn clear_reservation(
 /// checkpoint resume is distinguished from an ordinary launch by its own
 /// separate `checkpoint_auto_decided` event, emitted by the caller BEFORE
 /// this function ever runs, not by mutating either event's shape here.
+/// SPIKE (throwaway branch, never merged): run the stage's agent in this
+/// process, with no detached supervisor, no pending or published record and no
+/// promotion watch, then advance in this process.
+fn spike_run_in_foreground(
+    state: &mut State,
+    program: &str,
+    args: &[String],
+    extra_env: &[(String, String)],
+    launch: monitor::MonitorLaunch,
+) -> Result<(), CliError> {
+    let spike_err = |what: &str, err: String| CliError::Message(format!("spike: {what}: {err}"));
+    let ctx = launch_context()?;
+    let reservation = monitor::Reservation::new(&ctx, state)
+        .map_err(|err| spike_err("reservation", err.to_string()))?;
+    let is_stream = matches!(launch, monitor::MonitorLaunch::PipeOwning { .. });
+    let io = match launch {
+        monitor::MonitorLaunch::PipeOwning { prompt } => monitor::StageIo::Stream {
+            prompt,
+            idle_timeout: monitor::idle_timeout_setting_for(state.agent).timeout,
+        },
+        monitor::MonitorLaunch::Legacy => monitor::StageIo::Capture,
+    };
+    let socket = devflow_core::supervisor::SocketPath::new(reservation.socket_path().to_path_buf())
+        .map_err(|err| spike_err("socket path", err.to_string()))?;
+    let (project_root, phase, stage) = (state.project_root.clone(), state.phase, state.stage);
+    let mut spec = monitor::StageSpec::new(
+        project_root.clone(),
+        phase,
+        state.agent,
+        program.to_string(),
+        io,
+        socket,
+        reservation.launch_id().to_string(),
+    );
+    spec.stage = Some(stage);
+    spec.workdir = state
+        .worktree_path
+        .clone()
+        .unwrap_or_else(|| project_root.clone());
+    spec.args = args.to_vec();
+    spec.envs = extra_env.to_vec();
+    println!(
+        "spike: stage {stage} running in the foreground (pid {})",
+        std::process::id()
+    );
+    let guard = is_stream.then(|| {
+        AutoChainGuard::engage(&spec.workdir, auto_chain_flag_eligible(stage, state.mode))
+    });
+    let run = monitor::run_supervised_stage(spec)
+        .map_err(|err| spike_err("stage supervisor", err.to_string()))?;
+    drop(guard);
+    let outcome = run.outcome;
+    run.supervisor.finish();
+    reservation.discard();
+    println!("spike: agent ended: {outcome:?}");
+    match outcome {
+        AgentOutcome::Completed(_) => advance_for_stage(&project_root, Some(phase), Some(stage)),
+        _ => {
+            commit(state, |s| {
+                s.stopped = true;
+                s.stop_reason = Some("spike: interrupted in the foreground".to_string());
+            })?;
+            Ok(())
+        }
+    }
+}
+
 fn spawn_agent_and_record(
     state: &mut State,
     program: &str,
@@ -2179,6 +2246,10 @@ fn spawn_agent_and_record(
         s.checkpoint_resumes = checkpoint_resumes;
     })?;
 
+    if std::env::var_os("DEVFLOW_SPIKE_FOREGROUND").is_some() {
+        return spike_run_in_foreground(state, program, args, extra_env, launch);
+    }
