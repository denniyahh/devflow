+/// SPIKE (throwaway): one Plan stage run in the foreground by `devflow start`
+/// itself, with a stand-in agent. Every assertion is made the moment `start`
+/// returns, with no wait.
+#[test]
+fn spike_start_runs_one_stage_in_the_foreground() {
+    let phase = PhaseId::new(68);
+    let home = common::HermeticHome::new();
+    let repo = tempfile::tempdir().unwrap();
+    let root = repo.path().canonicalize().unwrap();
+    init_repo(&root, phase);
+    let logs = tempfile::tempdir().unwrap();
+    let fake_bin = Shape::Capture.fake_bin(logs.path(), AgentRun::Finishing);
+    let _reaper = common::LaunchedRunReaper::new(&root, phase, vec![]);
+
+    let existing = std::env::var_os("PATH").unwrap_or_default();
+    let path = format!("{}:{}", fake_bin.path.display(), existing.to_string_lossy());
+    let started = Instant::now();
+    let output = common::hermetic_devflow(&home)
+        .args(["start", "--phase", &phase.to_string(), "--agent", "codex"])
+        .args(["--mode", "supervise", "--no-worktree", "--until", "plan"])
+        .arg(&root)
+        .current_dir(&root)
+        .env("PATH", path)
+        .env("DEVFLOW_SPIKE_FOREGROUND", "1")
+        .output()
+        .expect("run devflow start");
+    let stdout = String::from_utf8_lossy(&output.stdout);
+    let stderr = String::from_utf8_lossy(&output.stderr);
+    eprintln!(
+        "SPIKE exit={:?} elapsed={:?}\n--- stdout\n{stdout}\n--- stderr\n{stderr}",
+        output.status.code(),
+        started.elapsed()
+    );
+    let events = fs::read_to_string(devflow_core::events::events_path(&root)).unwrap_or_default();
+    eprintln!("--- events\n{events}");
+    let state = devflow_core::workflow::load_state(&root, phase).expect("state");
+    eprintln!("--- state\n{state:#?}");
+
+    assert!(output.status.success(), "start failed");
+    assert!(stdout.contains("spike: stage plan running in the foreground"));
+    assert!(state.stopped, "the run is stopped at --until plan on return");
+    assert!(state.supervisor.is_none(), "no supervisor was recorded");
+    assert!(state.pending_supervisor.is_none(), "no launch is pending");
+    assert!(
+        !events.contains("\"stage_launched\""),
+        "no detached launch happened"
+    );
+    assert!(
+        events
+            .lines()
+            .any(|line| line.contains("\"advance_evaluated\"")
+                && line.contains("\"status\":\"success\"")),
+        "the in-process advance evaluated the stage as success"
+    );
+    let exit = fs::read_to_string(devflow_core::agent_result::exit_code_path(&root, phase))
+        .expect("exit file");
+    assert_eq!(exit.trim(), "0");
+    let agent_pid: u32 =
+        fs::read_to_string(devflow_core::agent_result::agent_pid_path(&root, phase))
+            .expect("agent pid file")
+            .trim()
+            .parse()
+            .expect("a pid");
+    assert!(
+        !devflow_core::agent::agent_running(agent_pid),
+        "the agent is gone when start returns"
+    );
+}
