+// ---- SPIKE (throwaway): the Claude-shaped stand-in in the foreground ----
+
+/// A `devflow <args> <root>` command with the spike switch on and the rig's
+/// fake `claude` first on PATH, its output appended to `out`.
+fn spike_cmd(rig: &FinishRig, args: &[&str], out: &Path) -> std::process::Command {
+    let existing = std::env::var_os("PATH").unwrap_or_default();
+    let path = format!(
+        "{}:{}",
+        rig.fake_bin.path.display(),
+        existing.to_string_lossy()
+    );
+    let file = fs::OpenOptions::new()
+        .create(true)
+        .append(true)
+        .open(out)
+        .unwrap();
+    let mut command = common::hermetic_devflow(&rig.home);
+    command
+        .args(args)
+        .arg(&rig.root)
+        .current_dir(&rig.root)
+        .env("PATH", path)
+        .env("DEVFLOW_SPIKE_FOREGROUND", "1")
+        .stdin(std::process::Stdio::null())
+        .stdout(file.try_clone().unwrap())
+        .stderr(file);
+    command
+}
+
+fn spike_wait(child: &mut std::process::Child, within: Duration) -> Option<i32> {
+    let mut code = None;
+    holds_within(within, || match child.try_wait().unwrap() {
+        Some(status) => {
+            code = Some(status.code().unwrap_or(-1));
+            true
+        }
+        None => false,
+    });
+    code
+}
+
+fn spike_dump(label: &str, rig: &FinishRig, out: &Path) {
+    eprintln!(
+        "=== {label}\n--- output\n{}\n--- events\n{}\n--- state\n{:#?}",
+        fs::read_to_string(out).unwrap_or_default(),
+        rig.events_text(),
+        devflow_core::workflow::load_state(&rig.root, rig.phase)
+    );
+}
+
+/// The rig's passing agent, which waits (up to 120 s) while `<dir>/finish` is absent.
+fn spike_waiting_claude(dir: &Path) -> String {
+    passing_claude().replace(
+        "git commit -q",
+        &format!(
+            "if [ ! -e '{}/finish' ]; then sleep 120; fi\ngit commit -q",
+            dir.display()
+        ),
+    )
+}
+
+/// Wait for the foreground Plan agent and return its pid (its group's id).
+fn spike_wait_for_agent(rig: &FinishRig, out: &Path) -> u32 {
+    let pid_file = devflow_core::agent_result::agent_pid_path(&rig.root, rig.phase);
+    let mut pid = 0;
+    let found = holds_within(RUN_WAIT, || {
+        let announced = fs::read_to_string(out)
+            .unwrap_or_default()
+            .contains("spike: stage plan running");
+        pid = fs::read_to_string(&pid_file)
+            .ok()
+            .and_then(|text| text.trim().parse().ok())
+            .unwrap_or(0);
+        announced && pid > 1 && devflow_core::agent::agent_running(pid)
+    });
+    if !found {
+        spike_dump("agent never appeared", rig, out);
+        panic!("the foreground Plan agent never appeared");
+    }
+    pid
+}
+
+#[test]
+fn spike_claude_shape_runs_three_stages_and_takes_a_gate_answer_from_a_second_process() {
+    let phase = PhaseId::new(69);
+    let rig = FinishRig::new(phase);
+    rig.stub_gsd(&vec![devflow_core::test_support::gsd_status_json(GsdStatus::Passed); 12]);
+    let _reaper = common::LaunchedRunReaper::new(&rig.root, phase, vec![]);
+    let out = rig.notify.path().join("start.out");
+    let number = phase.to_string();
+    let mut child = spike_cmd(
+        &rig,
+        &["start", "--phase", &number, "--agent", "claude", "--mode", "supervise"],
+        &out,
+    )
+    .spawn()
+    .unwrap();
+    let gated = holds_within(RUN_WAIT, || {
+        rig.validate_gates() >= 1 || child.try_wait().unwrap().is_some()
+    });
+    let running_at_gate = child.try_wait().unwrap().is_none();
+    spike_dump("at the gate", &rig, &out);
+    assert!(gated && rig.validate_gates() == 1, "one Validate gate fired");
+    assert!(running_at_gate, "start is still running while the gate waits");
+    rig.answer_validate("approve");
+    let code = spike_wait(&mut child, RUN_WAIT);
+    spike_dump("after the answer", &rig, &out);
+    if code.is_none() {
+        let _ = child.kill();
+        let _ = child.wait();
+    }
+    assert_eq!(code, Some(0), "start exits 0 after the approval");
+    assert!(rig.state().finished, "the run is finished");
+    assert!(rig.positions("stage_launched").is_empty(), "no detached launch");
+    let evaluated: Vec<String> = rig
+        .events()
+        .iter()
+        .filter(|event| event["event"] == "advance_evaluated")
+        .map(|event| format!("{}:{}", event["stage"], event["status"]))
+        .collect();
+    eprintln!("evaluated: {evaluated:?}");
+}
