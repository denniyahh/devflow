+#[test]
+fn spike_interrupt_to_the_foreground_group_ends_the_agent_and_records_a_stop() {
+    use std::os::unix::process::CommandExt as _;
+    let phase = PhaseId::new(70);
+    let rig = FinishRig::with_claude(phase, spike_waiting_claude);
+    let _reaper = common::LaunchedRunReaper::new(&rig.root, phase, vec![]);
+    let out = rig.notify.path().join("start.out");
+    let number = phase.to_string();
+    let mut child = spike_cmd(
+        &rig,
+        &["start", "--phase", &number, "--agent", "claude", "--mode", "auto"],
+        &out,
+    )
+    .process_group(0)
+    .spawn()
+    .unwrap();
+    let agent = spike_wait_for_agent(&rig, &out);
+    eprintln!(
+        "runner group {} members {:?}; agent group {agent} members {:?}",
+        child.id(),
+        group_members(child.id()),
+        group_members(agent)
+    );
+    // What a terminal's Ctrl-C does: SIGINT to the foreground process group.
+    common::signal_group(child.id(), libc::SIGINT);
+    let code = spike_wait(&mut child, Duration::from_secs(30));
+    let left = group_members(agent);
+    spike_dump("after SIGINT", &rig, &out);
+    eprintln!("exit code {code:?}; agent group members left {left:?}");
+    if code.is_none() {
+        let _ = child.kill();
+        let _ = child.wait();
+    }
+    common::signal_group(agent, libc::SIGKILL);
+    assert!(code.is_some(), "start exits after the interrupt");
+    assert!(left.is_empty(), "the agent group is gone");
+    assert!(rig.state().stopped, "the state records a stop");
+}
+
+#[test]
+fn spike_hard_kill_of_the_foreground_runner_then_resume() {
+    let phase = PhaseId::new(71);
+    let rig = FinishRig::with_claude(phase, spike_waiting_claude);
+    let _reaper = common::LaunchedRunReaper::new(&rig.root, phase, vec![]);
+    let out = rig.notify.path().join("start.out");
+    let number = phase.to_string();
+    let mut child = spike_cmd(
+        &rig,
+        &["start", "--phase", &number, "--agent", "claude", "--mode", "auto"],
+        &out,
+    )
+    .spawn()
+    .unwrap();
+    let agent = spike_wait_for_agent(&rig, &out);
+    child.kill().unwrap();
+    let _ = child.wait();
+    std::thread::sleep(Duration::from_secs(2));
+    let left = group_members(agent);
+    spike_dump("after SIGKILL of the runner", &rig, &out);
+    eprintln!("agent group members 2 s after the kill: {left:?}");
+    eprintln!("--- status\n{}", run_status(&rig.home, &rig.root));
+    common::signal_group(agent, libc::SIGKILL);
+    assert!(
+        holds_within(Duration::from_secs(10), || group_members(agent).is_empty()),
+        "cleanup: the agent group ends"
+    );
+    fs::write(rig.notify.path().join("finish"), "").unwrap();
+    let resume_out = rig.notify.path().join("resume.out");
+    let mut resume = spike_cmd(&rig, &["resume", "--phase", &number], &resume_out)
+        .spawn()
+        .unwrap();
+    let code = spike_wait(&mut resume, RUN_WAIT);
+    spike_dump("after resume", &rig, &resume_out);
+    eprintln!("resume exit code {code:?}; agent orphaned by the kill: {}", !left.is_empty());
+    if code.is_none() {
+        let _ = resume.kill();
+        let _ = resume.wait();
+    }
+    assert_eq!(code, Some(0), "resume exits 0");
+    assert!(rig.state().finished, "the resumed run finished");
+}
+
+#[test]
+fn spike_hard_kill_with_the_parent_death_guard() {
+    let phase = PhaseId::new(72);
+    let rig = FinishRig::with_claude(phase, spike_waiting_claude);
+    let _reaper = common::LaunchedRunReaper::new(&rig.root, phase, vec![]);
+    let out = rig.notify.path().join("start.out");
+    let number = phase.to_string();
+    let mut child = spike_cmd(
+        &rig,
+        &["start", "--phase", &number, "--agent", "claude", "--mode", "auto"],
+        &out,
+    )
+    .env("DEVFLOW_SPIKE_PDEATHSIG", "1")
+    .spawn()
+    .unwrap();
+    let agent = spike_wait_for_agent(&rig, &out);
+    let before = group_members(agent);
+    child.kill().unwrap();
+    let _ = child.wait();
+    std::thread::sleep(Duration::from_secs(2));
+    let left = group_members(agent);
+    eprintln!("GUARD agent {agent}: before {before:?}, 2 s after the kill {left:?}");
+    common::signal_group(agent, libc::SIGKILL);
+    assert!(!left.contains(&agent), "the agent itself is gone");
+    assert!(left.is_empty(), "the agent's children are gone too");
+}
+
+// ---- SPIKE (throwaway): the foreground runner as a transient user service ----
+
+fn spike_systemctl(args: &[&str]) -> String {
+    let output = std::process::Command::new("systemctl")
+        .arg("--user")
+        .args(args)
+        .output()
+        .expect("run systemctl");
+    String::from_utf8_lossy(&output.stdout).trim().to_string()
+}
+
+/// Start the rig's run as a transient user service and return (unit, agent pid).
+fn spike_start_as_service(rig: &FinishRig) -> (String, u32) {
+    let unit = format!("devflow-spike-{}-{}", std::process::id(), rig.phase);
+    let existing = std::env::var_os("PATH").unwrap_or_default();
+    let path = format!(
+        "{}:{}",
+        rig.fake_bin.path.display(),
+        existing.to_string_lossy()
+    );
+    let home = rig.home.home();
+    let started = std::process::Command::new("systemd-run")
+        .args(["--user", "--collect", "--quiet", "-p", "KillMode=control-group"])
+        .arg(format!("--unit={unit}"))
+        .arg(format!("--working-directory={}", rig.root.display()))
+        .arg(format!("--setenv=HOME={}", home.display()))
+        .arg(format!("--setenv=XDG_CACHE_HOME={}", home.join(".cache").display()))
+        .arg(format!("--setenv=XDG_CONFIG_HOME={}", rig.home.config_dir().display()))
+        .arg(format!("--setenv=DEVFLOW_CACHE_DIR={}", rig.home.cache_dir().display()))
+        .arg(format!("--setenv=PATH={path}"))
+        .arg("--setenv=DEVFLOW_SPIKE_FOREGROUND=1")
+        .arg(common::devflow_bin())
+        .args(["start", "--phase", &rig.phase.to_string()])
+        .args(["--agent", "claude", "--mode", "auto"])
+        .arg(&rig.root)
+        .output()
+        .expect("run systemd-run");
+    assert!(
+        started.status.success(),
+        "systemd-run failed: {}",
+        String::from_utf8_lossy(&started.stderr)
+    );
+    let pid_file = devflow_core::agent_result::agent_pid_path(&rig.root, rig.phase);
+    let mut agent = 0;
+    let found = holds_within(RUN_WAIT, || {
+        agent = fs::read_to_string(&pid_file)
+            .ok()
+            .and_then(|text| text.trim().parse().ok())
+            .unwrap_or(0);
+        agent > 1 && group_members(agent).len() >= 2
+    });
+    if !found {
+        eprintln!(
+            "service state: {}\nevents:\n{}",
+            spike_systemctl(&["status", &unit]),
+            rig.events_text()
+        );
+        let _ = spike_systemctl(&["stop", &unit]);
+        panic!("the service's Plan agent never appeared");
+    }
+    (unit, agent)
+}
+
+#[test]
+fn spike_service_hard_kill_takes_the_agent_tree_down() {
+    let phase = PhaseId::new(73);
+    let rig = FinishRig::with_claude(phase, spike_waiting_claude);
+    let _reaper = common::LaunchedRunReaper::new(&rig.root, phase, vec![]);
+    let (unit, agent) = spike_start_as_service(&rig);
+    let before = group_members(agent);
+    let active_before = spike_systemctl(&["is-active", &unit]);
+    let main_pid: i32 = spike_systemctl(&["show", "-p", "MainPID", "--value", &unit])
+        .parse()
+        .expect("MainPID");
+    assert!(main_pid > 1, "refusing to signal pid {main_pid}");
+    // SAFETY: `main_pid > 1` is the service's main process, read just above.
+    assert_eq!(unsafe { libc::kill(main_pid, libc::SIGKILL) }, 0);
+    std::thread::sleep(Duration::from_secs(2));
+    let left = group_members(agent);
+    let active_after = spike_systemctl(&["is-active", &unit]);
+    eprintln!(
+        "SERVICE-KILL active before {active_before:?}; agent group before {before:?}; \
+         2 s after the kill {left:?}; active after {active_after:?}"
+    );
+    let _ = spike_systemctl(&["stop", &unit]);
+    common::signal_group(agent, libc::SIGKILL);
+    assert_eq!(active_before, "active");
+    assert!(left.is_empty(), "the whole agent group is gone");
+    assert_ne!(active_after, "active");
+}
+
+#[test]
+fn spike_service_stop_ends_the_agent_and_records_a_stop() {
+    let phase = PhaseId::new(74);
+    let rig = FinishRig::with_claude(phase, spike_waiting_claude);
+    let _reaper = common::LaunchedRunReaper::new(&rig.root, phase, vec![]);
+    let (unit, agent) = spike_start_as_service(&rig);
+    let _ = spike_systemctl(&["stop", &unit]);
+    let left = group_members(agent);
+    let state = rig.state();
+    eprintln!(
+        "SERVICE-STOP agent group after stop {left:?}; stopped {} reason {:?}",
+        state.stopped, state.stop_reason
+    );
+    common::signal_group(agent, libc::SIGKILL);
+    assert!(left.is_empty(), "the agent group is gone");
+    assert!(state.stopped, "the stop is recorded");
+}
