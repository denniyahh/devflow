diff --git a//tmp/review48-proof/crates/devflow-core/src/recover.rs b//tmp/review48-proof/crates/devflow-core/src/recover.rs
index e538a46d3926a86b64510c99340ecccd773ad2fc..1a389b83e52f5cd0bbe446100a18a504dfdf621a
--- a//tmp/review48-proof/crates/devflow-core/src/recover.rs
+++ b//tmp/review48-proof/crates/devflow-core/src/recover.rs
@@ -471,6 +471,31 @@
         assert!(workflow::list_states(dir.path()).is_empty());
     }
 
+    #[test]
+    fn proof_clean_deletes_a_stale_state_while_its_phase_lock_is_live() {
+        let dir = tempfile::tempdir().unwrap();
+        let phase = PhaseId::new(77);
+        let state = state_aged_phase(
+            dir.path(),
+            phase,
+            STALE_THRESHOLD.as_secs() + 60,
+            Some(DEAD_PID),
+        );
+        workflow::save_state(&state).unwrap();
+        let _gate_waiter_lock = crate::lock::acquire(dir.path(), phase).unwrap();
+
+        clean(dir.path()).unwrap();
+
