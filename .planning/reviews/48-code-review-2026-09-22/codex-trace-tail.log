+use devflow_core::gates::{GateResponse, Gates};
+use devflow_core::phase_id::PhaseId;
+use devflow_core::stage::Stage;
+
+#[test]
+fn response_left_after_cleanup_is_consumed_by_the_next_same_stage_gate() {
+    let dir = tempfile::tempdir().unwrap();
+    let root = dir.path();
+    let phase = PhaseId::new(77);
+    let response = GateResponse {
+        approved: true,
+        note: Some("old approval".into()),
+        responded_by: Some("old run".into()),
+    };
+
+    Gates::write_gate(root, phase, Stage::Code, "old gate").unwrap();
+    Gates::respond(root, phase, Stage::Code, &response).unwrap();
+    Gates::cleanup(root, phase, Stage::Code).unwrap();
+
+    // This is the exact on-disk state caused when a responder passes its
+    // request-exists check before another process cleans the gate, then links
+    // its prepared response after that cleanup.
+    std::fs::write(
+        Gates::response_path(root, phase, Stage::Code),
+        serde_json::to_string(&response).unwrap(),
+    )
+    .unwrap();
+    Gates::write_gate(root, phase, Stage::Code, "new gate").unwrap();
+
+    assert_eq!(
+        Gates::poll_response(root, phase, Stage::Code, 0),
+        Some(response),
+        "the new gate consumes the prior run's approval immediately"
+    );
+}
+
+#[test]
+fn cleanup_without_a_late_response_leaves_the_next_same_stage_gate_unanswered() {
+    let dir = tempfile::tempdir().unwrap();
+    let root = dir.path();
+    let phase = PhaseId::new(78);
+    let response = GateResponse {
+        approved: true,
+        note: Some("old approval".into()),
+        responded_by: Some("old run".into()),
+    };
+
+    Gates::write_gate(root, phase, Stage::Code, "old gate").unwrap();
+    Gates::respond(root, phase, Stage::Code, &response).unwrap();
+    Gates::cleanup(root, phase, Stage::Code).unwrap();
+    Gates::write_gate(root, phase, Stage::Code, "new gate").unwrap();
+
+    assert_eq!(Gates::poll_response(root, phase, Stage::Code, 0), None);
+}

