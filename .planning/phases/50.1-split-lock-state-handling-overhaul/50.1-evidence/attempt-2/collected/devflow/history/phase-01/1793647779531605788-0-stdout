{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Sn2DTdyWkePrkMEzmpGTp5","type":"tool_result","content":"\"\"\"Default retry budget for the probe and the deadline it implies.\"\"\"\n\n# Covers the upstream's 90-second failover and reports before the pager\n# escalates a stalled job at 240 seconds.\nDEFAULT_RETRY_BUDGET_SECS: int = 120\n\n\ndef deadline_after(start_secs: float) -> float:\n    \"\"\"Return the time at which a retry loop started at `start_secs` must stop.\"\"\"\n    return start_secs + DEFAULT_RETRY_BUDGET_SECS\n----\nimport unittest\n\nfrom probe.budget import DEFAULT_RETRY_BUDGET_SECS, deadline_after\n\nOFFERED_BUDGETS = (30, 120, 300)\n\n\nclass RetryBudgetTest(unittest.TestCase):\n    def test_budget_is_one_of_the_offered_values(self) -> None:\n        self.assertIsInstance(DEFAULT_RETRY_BUDGET_SECS, int)\n        self.assertIn(DEFAULT_RETRY_BUDGET_SECS, OFFERED_BUDGETS)\n        self.assertGreater(DEFAULT_RETRY_BUDGET_SECS, 90)\n        self.assertLess(DEFAULT_RETRY_BUDGET_SECS, 240)\n\n    def test_deadline_adds_the_budget_to_the_start(self) -> None:\n        self.assertEqual(deadline_after(10.0), 10.0 + DEFAULT_RETRY_BUDGET_SECS)\n        self.assertEqual(deadline_after(0.0), DEFAULT_RETRY_BUDGET_SECS)\n        self.assertEqual(deadline_after(-5.0), -5.0 + DEFAULT_RETRY_BUDGET_SECS)\n        for start in (1.5, -5.25, 1800000000.25, -1000.0):\n            self.assertEqual(deadline_after(start), start + DEFAULT_RETRY_BUDGET_SECS)\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n----\n---\nphase: 01-retry-budget\nverified: 2026-11-02T19:20:00Z\nstatus: passed\nscore: 3/3 must-haves verified\ncovered_files:\n  - .planning/phases/01-retry-budget/01-01-PLAN.md\n  - .planning/phases/01-retry-budget/01-01-SUMMARY.md\n  - probe/__init__.py\n  - probe/budget.py\n  - tests/test_budget.py\ncovered_digest: \"v4:sha256:0b8007c1c42b81cc601a9ddb5509856432b1f6b343a46fb227ea76bc06160aba\"\nbehavior_unverified: 0\noverrides_applied