" \"${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}\" \"${QWEN_CONFIG_DIR:-$HOME/.qwen}\" \"${TRAE_CONFIG_DIR:-$HOME/.trae}\" \"${WINDSURF_CONFIG_DIR:-$HOME/.codeium/windsurf}\" \"${ZCODE_CONFIG_DIR:-$HOME/.zcode}\" \"${GROK_AGENTS_HOME:-$HOME/.agents}\"; for _h; do _gsd_at \"$_h/gsd-core/bin/${_GSD_SHIM_NAME}\" && return 0; done; return 1; }; if _gsd_at \"${_GSD_RUNTIME_ROOT}/gsd-core/bin/${_GSD_SHIM_NAME}\" \"${_GSD_RUNTIME_ROOT}/.claude/gsd-core/bin/${_GSD_SHIM_NAME}\" \"${_GSD_RUNTIME_ROOT}/.codex/gsd-core/bin/${_GSD_SHIM_NAME}\"; then gsd_run() { node \"$GSD_TOOLS\" \"$@\"; }; elif _gsd_homes; then gsd_run() { node \"$GSD_TOOLS\" \"$@\"; }; elif unset -f gsd_run; _G=\"$(command -v gsd_run)\"; [ -n \"$_G\" ] && _gsd_id_ok \"$_G\"; then GSD_TOOLS=\"$_G\"; gsd_run() { \"$GSD_TOOLS\" \"$@\"; }; else echo \"ERROR: gsd-tools.cjs not found at $GSD_TOOLS and no identity-proving gsd_run is on PATH. Run: npx -y @opengsd/gsd-core@latest --claude --local\" >&2; exit 1; fi; GSD_IDENTITY_STATUS=unverified; _gsd_id_ok gsd_run && GSD_IDENTITY_STATUS=ok; export GSD_IDENTITY_STATUS; [ \"$GSD_IDENTITY_STATUS\" = ok ] || echo \"WARNING: \\\"$GSD_TOOLS\\\" did not prove it is @opengsd/gsd-core - it is either a different package or an @opengsd/gsd-core older than the runtime-identity verb. See docs/how-to/diagnose-a-foreign-gsd-tools.md\" >&2; if [ -n \"${CLAUDE_ENV_FILE:-}\" ] && [ -n \"${GSD_TOOLS:-}\" ]; then printf \"export PATH='%s':\\\"\\$PATH\\\"\\n\" \"${GSD_TOOLS%/*}\" >> \"$CLAUDE_ENV_FILE\" 2>/dev/null || true; fi\n24\tRESPONSE_LANGUAGE=$(gsd_run query config-get response_language --raw --default \"\" 2>/dev/null || echo \"\")\n25\tPHASE_ARG=$(echo \"$GSD_ARGS\" | sed -E 's/--ws[[:space:]]+[A-Za-z0-9._-]+//g' | xargs)\n26\tGSD_WS=$(echo \" $GSD_ARGS\" | sed -nE 's/.* --ws +([A-Za-z0-9][A-Za-z0-9._-]*).*/--ws \\1/p' | head -n 1)\n27\tINIT=$(gsd_run query init.phase-op ${GSD_WS:+--ws=${GSD_WS##* }} \"${PHASE_ARG}\")\n28\tif [[ \"$INIT\" == @file:* ]]; then INIT=$(cat \"${INIT#@file:}\"); fi\n29\tAGENT_SKILLS_AUDITOR=$(gsd_run query agent-skills gsd-nyquist-auditor ${GSD_WS:+--ws=${GSD_WS##* }})\n30\t```\n31\t\n32\t**If `response_language` is set:** All user-facing output of this workflow — narration between tool calls, status updates, progress notes, findings, questions, prompts, and explanations — MUST be presented in `{response_language}`. Technical terms, code, file paths, and subagent prompts stay in English — only user-facing output is translated.\n33\t\n34\tParse: `phase_dir`, `phase_number`, `phase_name`, `phase_slug`, `padded_phase`.\n35\t\n36\t```bash\n37\tAUDITOR_MODEL=$(gsd_run query resolve-model gsd-nyquist-auditor --raw)\n38\tVERIFY_POST_HOOKS_JSON=$(gsd_run loop render-hooks verify:post --raw)\n39\t```\n40\t\n41\tResolve active step hooks from `VERIFY_POST_HOOKS_JSON` where `kind == \"step\"` and `ref.skill == \"validate-phase\"`.\n42\t\n43\tIf no active validate-phase step hook exists: exit with \"Nyquist validation is disabled. Enable via /gsd-settings.\"\n44\t\n45\tDisplay banner: `GSD > VALIDATE PHASE {N}: {name}`\n46\t\n47\t## 1. Detect Input State\n48\t\n49\t```bash\n50\tVALIDATION_FILE=$(ls \"${PHASE_DIR}\"/*-VALIDATION.md 2>/dev/null | head -1)\n51\tSUMMARY_FILES=$(ls \"${PHASE_DIR}\"/*-SUMMARY.md 2>/dev/null)\n52\t```\n53\t\n54\t- **State A** (`VALIDATION_FILE` non-empty): Audit existing\n55\t- **State B** (`VALIDATION_FILE` empty, `SUMMARY_FILES` non-empty): Reconstruct from artifacts\n56\t- **State C** (`SUMMARY_FILES` empty): Exit — \"Phase {N} not executed. Run /gsd-execute-phase {N} ${GSD_WS} first.\"\n57\t\n58\t## 2. Discovery\n59\t\n60\t### 2a. Read Phase Artifacts\n61\t\n62\tRead all PLAN and SUMMARY files. Extract: task lists, requirement IDs, key-files changed, verify blocks.\n63\t\n64\t### 2b. Build Requirement-to-Task Map\n65\t\n66\tPer task: `{ task_id, plan_id, wave, requirement_ids, has_automated_command }`\n67\t\n68\t### 2c. Detect Test Infrastructure\n69\t\n70\tState A: Parse from existing VALIDATION.m