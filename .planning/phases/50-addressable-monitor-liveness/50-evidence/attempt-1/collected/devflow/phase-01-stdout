{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017d6dkWLSiZ9VqAA8uaRdBg","type":"tool_result","content":"1\timport unittest\n2\tfrom unittest import mock\n3\t\n4\tfrom probe import budget\n5\tfrom probe.budget import DEFAULT_RETRY_BUDGET_SECS, deadline_after\n6\t\n7\t# 2**40 and 2**50 are exactly representable as floats, so equality is exact.\n8\tSTART_VALUES = (0.0, -1.0, -500.5, 0.5, 10.0, 1234.25, float(2**40), float(2**50))\n9\t\n10\t\n11\tclass DeadlineAfterTest(unittest.TestCase):\n12\t    def test_deadline_is_start_plus_budget_for_every_start_value(self) -> None:\n13\t        for start in START_VALUES:\n14\t            with self.subTest(start=start):\n15\t                self.assertEqual(\n16\t                    deadline_after(start), start + DEFAULT_RETRY_BUDGET_SECS\n17\t                )\n18\t\n19\t    def test_deadline_depends_on_the_start_it_is_given(self) -> None:\n20\t        results = {deadline_after(start) for start in START_VALUES}\n21\t        self.assertEqual(len(results), len(START_VALUES))\n22\t\n23\t    def test_deadline_shifts_one_for_one_with_the_start(self) -> None:\n24\t        for earlier, later in zip(START_VALUES, START_VALUES[1:]):\n25\t            with self.subTest(earlier=earlier, later=later):\n26\t                self.assertEqual(\n27\t                    deadline_after(later) - deadline_after(earlier), later - earlier\n28\t                )\n29\t\n30\t    def test_deadline_reads_the_budget_constant_not_a_copy_of_its_value(self) -> None:\n31\t        with mock.patch.object(budget, \"DEFAULT_RETRY_BUDGET_SECS\", 7):\n32\t            self.assertEqual(deadline_after(0.0), 7.0)\n33\t            self.assertEqual(deadline_after(-3.0), 4.0)\n34\t\n35\t\n36\tif __name__ == \"__main__\":\n37\t    unittest.main()\n38\t"}]},"parent_tool_use_id":"toolu_01A8rWEPCDydtbTMWbXdeLop","agent_id":"a8a3d6c55abcbb36d","session_id":"uuid-6","uuid":"uuid-529","timestamp":"2026-10-20T19:20:56.223Z","tool_result_meta":[{"id":"toolu