   503	/// Refuse before `devflow start` forks anything when `base` is stale
   504	/// relative to its remote. `Current`, `Ahead` and `Undeterminable` all
   505	/// return `Ok(())` (the last with a warning — the guard fails open where it
   506	/// cannot see, mirroring [`ensure_phase_reachable_on_base`]).
   507	///
   508	/// The `Behind` arm implements the operator's 2026-07-27 adjudication
   509	/// (999.51/D-18a): fast-forward when it is safe to do so, else refuse
   510	/// loudly. `Behind` establishes losslessness at the instant it was read — it
   511	/// says nothing about the instant of the write, since another writer, a
   512	/// hook, or a concurrent `devflow` may move `base` in between. The
   513	/// fast-forward is therefore a compare-and-swap:
   514	/// [`fast_forward_base_ref`] is called with the local base SHA resolved
   515	/// immediately before the write as `expected_old`, so a base that moved in
   516	/// that window causes the write to refuse rather than silently discard the
   517	/// intervening commit(s).
   518	///
   519	/// The checked-out precondition is evaluated across EVERY worktree of the
   520	/// repository via [`base_is_checked_out_anywhere`], not just
   521	/// `project_root`'s own `HEAD` — necessary because `git update-ref` carries
   522	/// no checked-out-branch protection of its own, unlike `git branch -f`.
   523	///
   524	/// RESIDUAL, documented rather than eliminated: a worktree that checks out
   525	/// `base` in the window between the repository-wide scan and the
   526	/// compare-and-swap is not protected by the scan; the compare-and-swap still
   527	/// prevents a lost update in that window, but it cannot prevent that
   528	/// worktree from observing a moved HEAD.
   529	///
   530	/// On ANY failure (checked out anywhere, either endpoint unresolvable, the
   531	/// compare-and-swap refusing, spawn error, non-zero exit) this falls
   532	/// through to the same refusal — never proceed silently after a failed
   533	/// fast-forward.
   534	///
   535	/// `Diverged` always refuses — a divergent base is never silently forked
   536	/// from.
   537	pub(crate) fn ensure_base_ref_current(project_root: &Path, base: &str) -> Result<(), CliError> {
   538	    match base_ref_currency(project_root, base) {
   539	        BaseRefCurrency::Current | BaseRefCurrency::Ahead => Ok(()),
   540	        BaseRefCurrency::Undeterminable => {
   541	            println!(
   542	                "warning: could not determine whether `{base}` is current with `{ORIGIN}/{base}` \
   543	                 — proceeding without a currency check (fail-open, per this module's \
   544	                 fail-open-where-blind contract)"
   545	            );
   546	            Ok(())
   547	        }
   548	        BaseRefCurrency::Diverged => {
   549	            let remote_ref = format!("{ORIGIN}/{base}");
   550	            Err(CliError::Message(format!(
   551	                "`{base}` and `{remote_ref}` have diverged — neither is an ancestor of the \
   552	                 other, so `devflow start` refuses to fork a phase worktree from either. \
   553	                 Resolve manually (e.g. `git checkout {base} && git rebase {remote_ref}`, or \
   554	                 `git reset --hard {remote_ref}` if `{base}`'s local commits are disposable), \
   555	                 then re-run `devflow start`."
   556	            )))
   557	        }
   558	        BaseRefCurrency::Behind { count } => {
   559	            let remote_ref = format!("{ORIGIN}/{base}");
   560	
   561	            if !base_is_checked_out_anywhere(project_root, base) {
   562	                let resolve = |rref: &str| {
   563	                    git_command(project_root)
   564	                        .args(["rev-parse", "--verify", "--quiet", rref])
   565	                        .output()
   566	                        .ok()
   567	                        .filter(|out| out.status.success())
   568	                        .map(|out| String::from_utf8_lossy(&out.stdout).trim().to_string())
   569	                };
   570	                let local_sha = resolve(&format!("refs/heads/{base}"));
