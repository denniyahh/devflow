    84	#[allow(clippy::too_many_arguments)]
    85	/// Whether phase `{NN}`'s GSD planning artifact (a `.planning/phases/{NN}-*/`
    86	/// file ending in `suffix`, e.g. `-CONTEXT.md`) exists on `develop` — the
    87	/// branch phase worktrees fork from. Fail-open on git errors (missing
    88	/// develop, not a repo): pre-flight must never block a run the later, more
    89	/// specific checks would allow.
    90	pub(crate) fn phase_artifact_on_develop(project_root: &Path, phase: PhaseId, suffix: &str) -> bool {
    91	    let prefix = format!(".planning/phases/{padded}-", padded = phase.padded());
    92	    let output = git_command(project_root)
    93	        .args([
    94	            "ls-tree",
    95	            "-r",
    96	            "--name-only",
    97	            "develop",
    98	            "--",
    99	            ".planning/phases/",
   100	        ])
   101	        .output();
   102	    let Ok(out) = output else { return true };
   103	    if !out.status.success() {
   104	        return true;
   105	    }
   106	    String::from_utf8_lossy(&out.stdout).lines().any(|path| {
   107	        path.strip_prefix(&prefix)
   108	            .is_some_and(|rest| rest.contains('/') && rest.ends_with(suffix))
   109	    })
   110	}
