   310	// ---------------------------------------------------------------------------
   311	// 25e (999.51/D-18a): base-ref currency probe, siblings of the phase-
   312	// reachability probe above. `devflow start` forks its worktree from `base`
   313	// (DEVELOP) — if the local ref is behind its remote-tracking counterpart,
   314	// the fork happens against stale code while the reachability probe above
   315	// still passes, because the phase heading and directory exist on the STALE
   316	// local ref just as they do on the fresh remote one. This is 999.51's
   317	// explicitly-named "dangerous variant": a green run against the wrong
   318	// source, arriving through the base ref instead of the binary — the same
   319	// false-evidence shape D-18 exists to prevent.
   320	// ---------------------------------------------------------------------------
   321	
   322	/// Remote name this probe fetches and compares against — hardcoded, matching
   323	/// `devflow_core::git::origin_main_ancestor_status`'s existing convention
   324	/// (this project has no remote-name configuration knob).
   325	const ORIGIN: &str = "origin";
   326	
   327	/// The result of comparing a local base branch to its remote-tracking ref.
   328	/// Mirrors [`PhaseReachability`]'s shape: `Undeterminable` carries the same
   329	/// fail-open-where-blind meaning this module already documents for that
   330	/// sibling probe.
   331	#[derive(Debug, Clone, PartialEq, Eq)]
   332	pub(crate) enum BaseRefCurrency {
   333	    /// The local base ref equals its remote-tracking ref.
   334	    Current,
   335	    /// The local base ref is strictly AHEAD of its remote-tracking ref
   336	    /// (unpushed local work) — never treated as staleness.
   337	    Ahead,
   338	    /// The local base ref is strictly BEHIND its remote-tracking ref by
   339	    /// `count` commits, with no local divergence — the remote is a
   340	    /// lossless fast-forward target.
   341	    Behind { count: u32 },
   342	    /// Local and remote have both moved past their common ancestor — mutual
   343	    /// non-ancestors. A divergent base is never silently forked from.
   344	    Diverged,
   345	    /// The remote-tracking ref could not be resolved at all (no remote
   346	    /// configured, offline clone, or the fetch failed and the ref never
   347	    /// existed locally either) — the guard fails open in this case, per the
   348	    /// module's existing fail-open-where-blind contract.
   349	    Undeterminable,
   350	}
   351	
   352	/// Probe whether `base` is current with its remote-tracking ref in the
   353	/// repository at `project_root`. Follows `origin_main_ancestor_status`'s
   354	/// shape verbatim (`git rev-parse --verify --quiet` for ref existence, then
   355	/// `git merge-base --is-ancestor` — here in both directions, to distinguish
   356	/// behind/ahead/equal/diverged), but is preceded by a soft-failing
   357	/// `git fetch` so the comparison is made against a freshly-updated
   358	/// remote-tracking ref rather than merely "nobody has fetched recently."
   359	///
   360	/// The fetch updates ONLY the remote-tracking ref (`git fetch <remote> <base>`)
   361	/// — it never touches the local branch or the working tree, so it
   362	/// cannot fail with a "branch is checked out" error the way a refspec fetch
   363	/// into the local branch would. On spawn error or non-zero exit the fetch
   364	/// fails SOFT: a warning is printed and the comparison proceeds against
   365	/// whatever the remote-tracking ref currently holds (Phase 24's inherited
   366	/// D-06 precedent — a new code path must not introduce a false hard-block
   367	/// on correct work, and an offline machine is correct work).
   368	pub(crate) fn base_ref_currency(project_root: &Path, base: &str) -> BaseRefCurrency {
   369	    let remote_ref = format!("{ORIGIN}/{base}");
   370	
   371	    let fetch_ok = git_command(project_root)
   372	        .args(["fetch", "--quiet", ORIGIN, base])
   373	        .output()
   374	        .map(|out| out.status.success())
   375	        .unwrap_or(false);
   376	    if !fetch_ok {
   377	        println!(
   378	            "warning: could not fetch `{ORIGIN} {base}` — comparing `{base}` against \
   379	             whatever `{remote_ref}` currently resolves to locally, which may be stale"
   380	        );
   381	    }
   382	
   383	    let ref_exists = git_command(project_root)
   384	        .args(["rev-parse", "--verify", "--quiet", &remote_ref])
   385	        .output()
   386	        .map(|out| out.status.success())
   387	        .unwrap_or(false);
   388	    if !ref_exists {
   389	        return BaseRefCurrency::Undeterminable;
   390	    }
   391	
   392	    let is_ancestor = |ancestor: &str, descendant: &str| {
   393	        git_command(project_root)
   394	            .args(["merge-base", "--is-ancestor", ancestor, descendant])
   395	            .output()
   396	            .map(|out| out.status.success())
   397	            .unwrap_or(false)
   398	    };
   399	    let local_is_ancestor_of_remote = is_ancestor(base, &remote_ref);
   400	    let remote_is_ancestor_of_local = is_ancestor(&remote_ref, base);
   401	
   402	    match (local_is_ancestor_of_remote, remote_is_ancestor_of_local) {
   403	        (true, true) => BaseRefCurrency::Current,
   404	        (false, true) => BaseRefCurrency::Ahead,
   405	        (false, false) => BaseRefCurrency::Diverged,
   406	        (true, false) => {
   407	            let count = git_command(project_root)
   408	                .args(["rev-list", "--count", &format!("{base}..{remote_ref}")])
   409	                .output()
   410	                .ok()
   500	        .unwrap_or(false)
   501	}
