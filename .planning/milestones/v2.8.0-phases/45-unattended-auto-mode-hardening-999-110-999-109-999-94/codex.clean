   980	/// Which tree a hook batch operates on.
   981	///
   982	/// The Validate→Ship transition batch (`DocsUpdate`) authors material *about
   983	/// the branch being shipped*, so it must write into that phase's worktree —
   984	/// otherwise its output is stranded on the base branch, uncommitted and
   985	/// divorced from the commits it describes (found live: Phase 17's changelog
   986	/// entry landed on `develop` while every one of its commits sat on
   987	/// `feature/phase-17`).
   988	///
   989	/// The terminal batch (`Merge`, `VersionBump`, `ChangelogAppend`,
   990	/// `BranchCleanup`) is the exact opposite: it merges the feature branch INTO
   991	/// the base branch, tags the base branch, and deletes the feature branch.
   992	/// Those are primary-checkout operations and retargeting them at the
   993	/// worktree would be a correctness regression. `ChangelogAppend` moved here
   994	/// in 17-12 (WR-04) — a release record naming a version only becomes true
   995	/// once `VersionBump` has tagged it, so the changelog entry belongs on the
   996	/// base branch alongside the tag, not in the worktree. Do not restore
   997	/// 17-10's worktree targeting to this hook.
   998	///
   999	/// Falls back to `project_root` whenever no worktree is configured, so
  1000	/// `--no-worktree` runs are unaffected.
  1001	pub(crate) fn hook_context_root(
  1002	    project_root: &Path,
  1003	    state: &State,
  1004	    terminal_batch: bool,
  1005	) -> PathBuf {
  1006	    if terminal_batch {
  1007	        return project_root.to_path_buf();
  1008	    }
  1009	    state
  1010	        .worktree_path
  1011	        .as_ref()
  1012	        .filter(|path| path.exists())
  1013	        .map(|path| path.to_path_buf())
  1014	        .unwrap_or_else(|| project_root.to_path_buf())
  1015	}
