   335	        .unwrap();
   336	        let _env = EnvOverride::set("DEVFLOW_REVIEW_ANGLES", "security, docs accuracy");
   337	
   338	        assert_eq!(
   339	            review_angles(dir.path()),
   340	            Some(vec!["security".into(), "docs accuracy".into()])
