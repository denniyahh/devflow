    74	                .unwrap_or_else(|error| panic!("failed to read {}: {error}", path.display()))
    75	        })
    76	        .collect::<Vec<_>>()
    77	        .join("\n")
    78	}
    79	
    80	fn rust_source() -> String {
    81	    fn visit(dir: &Path, files: &mut Vec<PathBuf>) {
    82	        let Ok(entries) = std::fs::read_dir(dir) else {
    83	            return;
    84	        };
    85	        for entry in entries.flatten() {
    86	            let path = entry.path();
    87	            if path.is_dir() {
    88	                visit(&path, files);
    89	            } else if path.extension().and_then(|ext| ext.to_str()) == Some("rs") {
    90	                files.push(path);
   200	                        && name.chars().all(char::is_alphabetic)
   201	                })
   202	            {
   203	                variants.push(name.to_ascii_lowercase());
   204	            }
   205	        }
   206	        depth += line.matches('{').count() as i32;
   207	        depth -= line.matches('}').count() as i32;
   208	        if depth <= 0 {
   209	            break;
   210	        }
   211	    }
   212	    variants.sort();
   213	    variants.dedup();
   214	    variants
   215	}
