    18	/// Whether the build embedded in `embedded_commit` is stale relative to
    19	/// `execution_root`'s current `HEAD` — the tree where the code under test
    20	/// actually lives (18c: the phase's worktree when one is set, else
    21	/// `project_root` — see `enforce_build_staleness`) — the ancestry half of
    22	/// D-19's composite definition. Per git's documented exit-code contract for
    23	/// `merge-base --is-ancestor` (exit 0 = ancestor, exit 1 = not, other =
    24	/// error/unknown commit — Pitfall 4), exit 1 is treated as definitively
    25	/// Stale; any other outcome (including an empty `embedded_commit` — D-20:
    26	/// absence of provenance is not staleness) is Indeterminate, never a false
    27	/// block. WR-01 (17-06 gap closure): exit 0 alone is NOT sufficient for
    28	/// Fresh — `merge-base --is-ancestor` also exits 0 when `embedded_commit` is
    29	/// a STRICT ancestor of HEAD (HEAD moved forward since the build), which is
    30	/// exactly the "committed new commits, forgot to rebuild" incident class
    31	/// this fix closes. An EXACT match to the current HEAD commit is genuinely
    32	/// Fresh; so, per 23g, is a strict-ancestor OR a genuinely divergent
    33	/// (mutually non-ancestor) range whose committed diff touches no
    34	/// build-affecting file (`ancestry_range_affects_build`).
    35	#[derive(Debug, Clone, Copy, PartialEq, Eq)]
    36	pub(crate) enum Staleness {
    37	    Fresh,
    38	    Stale,
    39	    /// The embedded commit is a strict DESCENDANT of `execution_root`'s
    40	    /// HEAD: the binary is newer than the source it drives. Not the
    41	    /// "committed, forgot to rebuild" incident this gate exists to catch,
    42	    /// so it never blocks — but it is still a build/source mismatch worth
    43	    /// surfacing.
    44	    Ahead,
    45	    Indeterminate,
    46	}
    47	
    48	fn embedded_commit_is_stale(execution_root: &Path, embedded_commit: &str) -> Staleness {
    49	    if embedded_commit.is_empty() {
    50	        return Staleness::Indeterminate;
    51	    }
    52	    let output = git_command(execution_root)
    53	        .args(["merge-base", "--is-ancestor", embedded_commit, "HEAD"])
    54	        .output();
    55	    match output.map(|o| o.status.code()) {
    56	        Ok(Some(0)) => match run_git_stdout(execution_root, &["rev-parse", "HEAD"]) {
    57	            Some(head) if head.trim() == embedded_commit.trim() => Staleness::Fresh,
    58	            Some(_) => {
    59	                if ancestry_range_affects_build(execution_root, embedded_commit) {
    60	                    Staleness::Stale
    61	                } else {
    62	                    Staleness::Fresh
    63	                }
    64	            }
    65	            None => Staleness::Indeterminate,
    66	        },
    67	        // Exit 1 only says "not an ancestor" — which is true both for a
    68	        // genuinely older/divergent commit AND for a descendant. Probe the
    69	        // reverse direction to tell them apart, or an ahead build gets
    70	        // reported as stale and hard-blocked.
    71	        Ok(Some(1)) => {
    72	            let reverse = git_command(execution_root)
    73	                .args(["merge-base", "--is-ancestor", "HEAD", embedded_commit])
    74	                .output();
    75	            match reverse.map(|o| o.status.code()) {
    76	                Ok(Some(0)) => Staleness::Ahead,
    77	                // 23g (2026-07-26 acceptance-run false block): genuine
    78	                // divergence — neither commit is an ancestor of the other —
    79	                // is content-checked exactly like the strict-ancestor arm
    80	                // above, reusing `ancestry_range_affects_build` verbatim. A
    81	                // divergent range that touches nothing build-affecting
    82	                // (e.g. only `.planning/` docs) must not hard-block.
    83	                Ok(Some(1)) => {
    84	                    if ancestry_range_affects_build(execution_root, embedded_commit) {
    85	                        Staleness::Stale
    86	                    } else {
    87	                        Staleness::Fresh
    88	                    }
    89	                }
    90	                _ => Staleness::Indeterminate,
    91	            }
    92	        }
    93	        _ => Staleness::Indeterminate,
    94	    }
    95	}
    96	
    97	/// 21d/D-07 (999.29), extended by 23g: whether the committed range between
    98	/// `embedded_commit` and `execution_root`'s current `HEAD` touches at least
    99	/// one build-affecting file — the content-aware narrowing of
   100	/// `embedded_commit_is_stale`'s strict-ancestor arm AND (23g) its
   101	/// divergent-lineage arm. DevFlow's own primary workflow commits docs
   102	/// (`.planning/`) constantly; a docs-only commit must not re-arm a hard
   103	/// block after every build, whether the resulting relationship is linear
   104	/// staleness or genuine divergence. Reuses `affects_compiled_binary`
   105	/// verbatim (D-07 — not forked or reimplemented). On any git failure,
   106	/// returns `true` (fail toward Stale) so a git error is never a false Fresh
   107	/// — mirrors `tree_has_modified_build_inputs`'s `None => Indeterminate`
   108	/// posture, adapted here to "assume the worse outcome" since this helper
   109	/// only returns a `bool`, not a tri-state.
   110	fn ancestry_range_affects_build(execution_root: &Path, embedded_commit: &str) -> bool {
   111	    run_git_stdout(
   112	        execution_root,
   113	        &["diff", "--name-only", embedded_commit, "HEAD"],
   114	    )
   115	    .map(|out| out.lines().any(affects_compiled_binary))
   116	    .unwrap_or(true)
   117	}
   118	
   119	/// Shell `git` in `project_root`, returning `None` on any failure (missing
   120	/// binary, non-git directory, non-zero exit) — same argv-array idiom as
   121	/// `build.rs`'s `run_git`.
   122	pub(crate) fn run_git_stdout(project_root: &Path, args: &[&str]) -> Option<String> {
   123	    let output = git_command(project_root).args(args).output().ok()?;
   124	    output
   125	        .status
   126	        .success()
   127	        .then(|| String::from_utf8_lossy(&output.stdout).to_string())
   128	}
   129	
   130	/// The live half of D-19's composite staleness (CR-02, 17-11): whether
   131	/// `execution_root`'s working tree — the tree where the code under test
   132	/// actually lives (18c) — CURRENTLY has any tracked, modified file that can
   133	/// change the compiled binary (`affects_compiled_binary`, reused from
   134	/// 17-10 — not duplicated). No timestamp is available any more (`build.rs`
   135	/// no longer embeds one — CR-02), so this cannot itself distinguish
   136	/// "modified after the build" from "modified before the build, still
   137	/// uncommitted"; combined with the build's own `build_dirty` flag in
   138	/// `combined_staleness`, it distinguishes "built clean, source changed
   139	/// since" (definitely Stale) from "built dirty, source still dirty"
   140	/// (Indeterminate — cannot tell "same dirt" from "more dirt" without a
   141	/// timestamp, Pitfall 4). Returns `None` when git itself is unavailable, so
   142	/// the composite check falls back to the ancestry arm alone.
   143	fn tree_has_modified_build_inputs(execution_root: &Path) -> Option<bool> {
   144	    let status = run_git_stdout(execution_root, &["status", "--porcelain"])?;
   145	    if status.trim().is_empty() {
   146	        return Some(false);
   147	    }
   148	    // WR-03: enumerate from `--porcelain` itself rather than `git ls-files -m`.
   149	    // `ls-files -m` compares worktree-vs-INDEX, so a *staged* source edit
   150	    // (`git add src/lib.rs`) reports nothing while porcelain reports `M `.
   151	    // That fell through to the ancestry arm as Fresh, letting a stale binary
   152	    // drive its own workspace — the exact false-evidence class this gate exists
   153	    // to catch. Untracked files stay excluded, as under `ls-files -m`.
   154	    Some(
   155	        status
   156	            .lines()
   157	            .any(|line| porcelain_tracked_path(line).is_some_and(affects_compiled_binary)),
   158	    )
   159	}
   160	
   161	/// The repo-relative path a `git status --porcelain` line refers to, or `None`
   162	/// for untracked (`??`) entries. Porcelain v1 lines are `XY<space>PATH`, with
   163	/// renames/copies rendered as `ORIG -> PATH`; the destination is the path that
   164	/// exists in the worktree. Paths containing special characters are quoted by
   165	/// git, so surrounding quotes are stripped.
   166	fn porcelain_tracked_path(line: &str) -> Option<&str> {
   167	    if line.len() < 4 || line.starts_with("??") {
   168	        return None;
   169	    }
   170	    let path = &line[3..];
   171	    let path = path.rsplit(" -> ").next().unwrap_or(path);
   172	    Some(path.trim_matches('"'))
   173	}
   174	
   175	/// Whether a repo-relative path can change the compiled binary. The live
   176	/// dirty-tree arm of the staleness check must consider ONLY these: a dirty
   177	/// `CHANGELOG.md` or `.planning/` file says nothing about whether the
   178	/// binary matches its source.
   179	///
   180	/// Found live — DevFlow's own `ChangelogAppend` hook dirtied `CHANGELOG.md`
   181	/// during the Validate→Ship transition, which an unfiltered check read as
   182	/// a stale build, hard-blocking Ship on a file the pipeline had just written.
   183	fn affects_compiled_binary(rel_path: &str) -> bool {
   184	    const BUILD_AFFECTING_FILES: [&str; 4] = [
   185	        "Cargo.toml",
   186	        "Cargo.lock",
   187	        "build.rs",
   188	        "rust-toolchain.toml",
   189	    ];
   190	    rel_path.ends_with(".rs")
   191	        || BUILD_AFFECTING_FILES
   192	            .iter()
   193	            .any(|name| rel_path == *name || rel_path.ends_with(&format!("/{name}")))
   194	}
   195	
   196	/// D-19: composite staleness (CR-02, 17-11: the dirty-flag arm replaces the
   197	/// old mtime arm; the ancestry arm below is unchanged). Evaluates
   198	/// `execution_root` — the tree where the code under test actually lives
   199	/// (18c). Decision table for the second signal, evaluated only once
   200	/// ancestry alone hasn't already settled Stale:
   201	///
   202	/// | build was dirty | tree has modified build inputs now | result |
   203	/// |---|---|---|
   204	/// | `false` | yes | **Stale** — built clean, source changed since (CR-02) |
   205	/// | `true` | yes | **Indeterminate** — can't distinguish "same dirt" from |
   206	/// |         |     | "more dirt" without a timestamp; warn, never block |
   207	/// |         |     | (Pitfall 4) |
   208	/// | either | no | fall through to the ancestry result unchanged |
   209	fn combined_staleness(
   210	    execution_root: &Path,
   211	    embedded_commit: &str,
   212	    build_dirty: bool,
   213	) -> Staleness {
   214	    let ancestry = embedded_commit_is_stale(execution_root, embedded_commit);
   215	    if ancestry == Staleness::Stale {
   216	        return Staleness::Stale;
   217	    }
   218	    match tree_has_modified_build_inputs(execution_root) {
   219	        Some(true) if build_dirty => Staleness::Indeterminate,
   220	        Some(true) => Staleness::Stale,
   221	        _ => ancestry,
   222	    }
   223	}
   224	
   225	/// D-17: whether `project_root` IS the DevFlow workspace itself (as opposed
   226	/// to some other project being driven by a devflow binary) — deterministic,
   227	/// offline, no config. Scans the `members = [...]` array of the root
   228	/// `Cargo.toml` for BOTH exact member-path strings, never a package `name`
   229	/// (the CLI crate's package is named `devflow`, not `devflow-cli` — a name
   230	/// match would never fire on the incident workspace; review consensus #2 +
   231	/// Plan 05 MEDIUM OpenCode). No TOML parser is used here: locating the
   232	/// `members` array's bounds first, then scanning within it, is the
   233	/// sanctioned middle ground and is unlikely to false-positive on an
   234	/// unrelated project.
   235	fn is_self_dogfood_workspace(project_root: &Path) -> bool {
   236	    let Ok(contents) = std::fs::read_to_string(project_root.join("Cargo.toml")) else {
   237	        return false;
   238	    };
   239	    // WR-05: anchor on the `members` KEY, not the first substring hit.
   240	    // `default-members` contains `members`, so a bare `find` would scan that
   241	    // array instead and silently degrade the self-dogfood hard block to a
   242	    // warning the moment the root manifest gains a `default-members` key
   243	    // above `members`.
   244	    let Some(members_start) = contents.match_indices("members").find_map(|(idx, _)| {
   245	        let preceded_by_ident = contents[..idx]
   246	            .chars()
   247	            .next_back()
   248	            .is_some_and(|ch| ch.is_alphanumeric() || ch == '_' || ch == '-');
   249	        (!preceded_by_ident).then_some(idx)
   250	    }) else {
   251	        return false;
   252	    };
   253	    let rest = &contents[members_start..];
   254	    let Some(open_rel) = rest.find('[') else {
   255	        return false;
   256	    };
   257	    let after_open = &rest[open_rel + 1..];
   258	    let Some(close_rel) = after_open.find(']') else {
   259	        return false;
   260	    };
   261	    let members = &after_open[..close_rel];
   262	    // WR-02: compare each array element for exact equality rather than
   263	    // substring-matching the whole array. `str::contains` would classify a
   264	    // workspace whose members are `crates/devflow-core-extras` /
   265	    // `crates/devflow-cli-plugin` as self-dogfood, and self-dogfood + Stale
   266	    // hard-blocks the pipeline — the one outcome this must never inflict on
   267	    // an unrelated project.
   268	    let has_member = |wanted: &str| {
   269	        members
   270	            .split(',')
   271	            .any(|entry| entry.trim().trim_matches(['"', '\'']).trim() == wanted)
   272	    };
   273	    has_member("crates/devflow-core") && has_member("crates/devflow-cli")
   274	}
   275	
   276	/// The outcome of the self-dogfood staleness gate (D-18): `Block` only when
   277	/// the project IS DevFlow's own workspace AND its build is confirmed Stale —
   278	/// everything else (an ordinary project, or an Indeterminate result on any
   279	/// project, Pitfall 4) only warns or is silent. Kept pure so the
   280	/// self-dogfood-blocks vs. ordinary-warns split is directly unit-testable.
   281	#[derive(Debug, Clone, Copy, PartialEq, Eq)]
   282	pub(crate) enum StalenessOutcome {
   283	    Block,
   284	    Warn,
   285	    Ok,
   286	}
   287	
   288	fn staleness_outcome(is_self_dogfood: bool, staleness: Staleness) -> StalenessOutcome {
   289	    match (is_self_dogfood, staleness) {
   290	        (true, Staleness::Stale) => StalenessOutcome::Block,
   291	        (false, Staleness::Stale) => StalenessOutcome::Warn,
   292	        (_, Staleness::Ahead) => StalenessOutcome::Warn,
   293	        (_, Staleness::Indeterminate) => StalenessOutcome::Warn,
   294	        (_, Staleness::Fresh) => StalenessOutcome::Ok,
   295	    }
   296	}
   297	
   298	/// D-17/D-18/D-19 (17d), execution_root (18c): the self-dogfood
   299	/// build-staleness gate, called from `launch_stage` before
   300	/// `monitor::spawn_monitor`. A Stale build against DevFlow's OWN workspace
   301	/// is a hard block — deliberately NOT an approvable gate, because approving
   302	/// it would reintroduce the exact Phase 16 false-evidence incident — but it
   303	/// is never SILENT: notify + an event fire before the blocking error is
   304	/// returned, so an unattended cron run still sees it (reconciling D-15's
   305	/// never-silent idiom with D-18's hard block). An ordinary project (or an
   306	/// Indeterminate result) only warns and proceeds.
   307	///
   308	/// 18c: ancestry/dirty-tree checks run against `execution_root` — the
   309	/// phase's worktree when `state.worktree_path` is set, else `project_root`
   310	/// — because that is the tree where the code under test actually lives.
   311	/// Evaluating a worktree-based phase against `project_root` alone is Round
   312	/// 4 CR-01's root cause: a binary behind the worktree branch can still be a
   313	/// descendant of `project_root`'s HEAD and misclassify `Ahead` (warn only).
   314	///
   315	/// `is_self_dogfood_workspace` deliberately stays anchored on `project_root`
   316	/// (Assumption A3, 18-RESEARCH.md Pitfall 4): it answers "is this workspace
   317	/// DevFlow's own repo at all", not "is the binary stale relative to tree X"
   318	/// — DevFlow's bookkeeping (`.planning/`, `.devflow/`) always lives in the
   319	/// main checkout even when execution does not, and `events::emit` keeps
   320	/// writing there too. A git worktree shares the same tracked files as the
   321	/// commit it is checked out to, so in practice both roots agree; the
   322	/// residual risk is a PLAN that modified the root `Cargo.toml`'s `members`
   323	/// array on the feature branch mid-flight, making the two roots disagree.
   324	pub(crate) fn enforce_build_staleness(
   325	    project_root: &Path,
   326	    state: &State,
   327	    embedded_commit: &str,
   328	    build_dirty: bool,
   329	) -> Result<(), CliError> {
   330	    let execution_root = state.worktree_path.as_deref().unwrap_or(project_root);
   331	    let staleness = combined_staleness(execution_root, embedded_commit, build_dirty);
   332	    let self_dogfood = is_self_dogfood_workspace(project_root);
   333	    match staleness_outcome(self_dogfood, staleness) {
   334	        StalenessOutcome::Block => {
   335	            let message = format!(
   336	                "self-dogfood stale build blocked for stage {}: a build-relevant file \
   337	                 (.rs/Cargo.toml/Cargo.lock/build.rs/rust-toolchain.toml) changed in {}'s \
   338	                 tracked source since this devflow binary was built, or its embedded commit \
   339	                 is not an ancestor of current HEAD at all — rebuild devflow before driving \
   340	                 its own workspace (D-18; the Phase 16 false-evidence incident){}",
   341	                state.stage,
   342	                execution_root.display(),
   343	                if state.worktree_path.is_some() {
   344	                    " — evaluated against this phase's WORKTREE HEAD, not the main checkout; \
   345	                     rebuild and reinstall the binary before resuming"
   346	                } else {
   347	                    ""
   348	                }
   349	            );
   350	            gates::fire_gate_notify(state.phase, state.stage, &message, true);
   351	            // WR-02 (18-fix): `message` embeds `execution_root.display()` —
   352	            // an absolute filesystem path (and, on a typical Linux/macOS
   353	            // path, the operator's OS username). `fire_gate_notify` and the
   354	            // returned `Err` below are the only places that path-bearing
   355	            // string is allowed to reach — `events::emit` persists to
   356	            // `.devflow/events.jsonl`, which `OPERATIONS.md` advertises as
   357	            // safe to "tail from any tool", so it must never carry a path.
   358	            // A bare, path-free label plus the two structured facts an
   359	            // operator actually needs (which stage, and whether a worktree
   360	            // was involved) are enough to explain the event without leaking
   361	            // anything.
   362	            events::emit(
   363	                project_root,
   364	                state.phase,
   365	                "self_dogfood_stale_blocked",
   366	                serde_json::json!({
   367	                    "stage": state.stage.to_string(),
   368	                    "reason": "stale_build_blocked",
   369	                    "worktree": state.worktree_path.is_some(),
   370	                }),
   371	            );
   372	            Err(CliError::Message(message))
   373	        }
   374	        StalenessOutcome::Warn => {
   375	            println!(
   376	                "warning: build provenance staleness check did not confirm a fresh build for \
   377	                 stage {} — proceeding (only DevFlow's own workspace is ever hard-blocked, D-18)",
   378	                state.stage
   379	            );
   380	            Ok(())
   650	    ///
   651	    /// (18-fix) `worktree_staleness_fixture` spawns real `git` subprocesses
   652	    /// unguarded — under concurrent load this raced this file's
   653	    /// PATH-mutating tests (the same `ENV_MUTEX`/19i flake class as
   654	    /// `transition_resets_infra_failures`), reproduced at roughly 1-in-8 to
   655	    /// 1-in-10. Guarded under `ENV_MUTEX` so it never runs concurrently with
   656	    /// a PATH mutator, mirroring the established pattern rather than
   657	    /// inventing a new one.
   658	    #[test]
   659	    fn embedded_commit_is_stale_uses_worktree_head() {
   660	        let _guard = env_lock();
   661	
   662	        let (outer, worktree_path, embedded_commit) = worktree_staleness_fixture();
   663	        let project_root = outer.path().join("project");
   664	
   665	        assert_eq!(
   666	            embedded_commit_is_stale(&project_root, &embedded_commit),
   667	            Staleness::Fresh,
   668	            "project_root's HEAD never moved, so the embedded commit is still an exact match"
   669	        );
   670	        assert_eq!(
   671	            embedded_commit_is_stale(&worktree_path, &embedded_commit),
   672	            Staleness::Stale,
   673	            "the worktree branch advanced two commits past the embedded commit — Round 4 \
   674	             CR-01's mechanism: evaluated against the wrong tree, this same commit reads Fresh"
   675	        );
   676	    }
   677	
   678	    /// 18c GREEN: `enforce_build_staleness` now evaluates ancestry against
   679	    /// the worktree HEAD (via `execution_root`) rather than `project_root`,
   680	    /// so a self-dogfood binary behind the worktree branch is a hard
   681	    /// BLOCK — closing Round 4 CR-01, where the identical scenario
   682	    /// evaluated against `project_root` alone classified `Ahead` (warn
   683	    /// only) because the embedded commit was still a descendant of
   684	    /// `develop`.
   685	    ///
   686	    /// (18-fix) Guarded under `ENV_MUTEX`, same rationale as
   687	    /// `embedded_commit_is_stale_uses_worktree_head` — this test also drives
   688	    /// `worktree_staleness_fixture`'s unguarded real `git` subprocesses.
   689	    #[test]
   690	    fn enforce_build_staleness_blocks_self_dogfood_behind_worktree_head() {
   691	        let _guard = env_lock();
   692	
   693	        let (outer, worktree_path, embedded_commit) = worktree_staleness_fixture();
   694	        let project_root = outer.path().join("project");
   695	        std::fs::write(
   696	            project_root.join("Cargo.toml"),
   697	            "[workspace]\nmembers = [\"crates/devflow-core\", \"crates/devflow-cli\"]\n",
   698	        )
   699	        .unwrap();
   700	        assert!(is_self_dogfood_workspace(&project_root));
   701	
   702	        let phase = PhaseId::new(90);
   703	        let mut state = State::new(phase, AgentKind::Claude, Mode::Auto, project_root.clone());
   704	        state.stage = Stage::Code;
   705	        state.worktree_path = Some(worktree_path.clone());
   706	
   707	        let err =
   708	            enforce_build_staleness(&project_root, &state, &embedded_commit, false).unwrap_err();
   709	        let message = err.to_string();
   710	        assert!(
   711	            message.contains(&worktree_path.display().to_string()),
   712	            "block message must name the worktree that was actually evaluated: {message}"
   713	        );
   714	        assert!(
   715	            !message.contains(&project_root.display().to_string()),
   716	            "block message must not name project_root when a worktree was evaluated: {message}"
   717	        );
   718	
   719	        // WR-02 (18-fix): the persisted event's `worktree` flag mirrors
   720	        // `state.worktree_path.is_some()`, path-free.
   721	        let last = devflow_core::events::last_event_for_phase(&project_root, phase)
   722	            .expect("staleness block must record an event before returning the error");
   723	        assert_eq!(last["reason"], "stale_build_blocked");
   724	        assert_eq!(last["worktree"], true);
   725	    }
   726	
   727	    /// 25-03 (Task 2, D-03/D-04/D-05 regression): the staleness adjudication
   728	    /// now happens exactly once, in `commands::start` — a mid-run stage
   729	    /// transition (`pipeline_launch::launch_stage_inner`, the exact function
   730	    /// 25b's Task 1 deleted the `enforce_build_staleness` call from) must not
   731	    /// re-invoke it.
   732	    ///
   733	    /// Proven behaviourally, not structurally — a test that merely grepped
   734	    /// `pipeline_launch.rs` for the absent call would pass against a
   735	    /// re-introduction anywhere else in the launch path. Instead the SAME
   736	    /// fixture, whose worktree HEAD is build-affecting-ahead of the embedded
   737	    /// commit, is adjudicated twice: once the way `start` adjudicates it (a
   738	    /// direct `enforce_build_staleness` call, which still refuses — the
   739	    /// Phase 16 protection is intact, D-05), and once the way a mid-run
   740	    /// stage transition adjudicates it (`launch_stage_inner`, driven with a
   741	    /// stubbed `claude` binary so it can actually complete rather than fail
   742	    /// for the unrelated reason of a missing agent binary). If the check
   743	    /// were re-invoked anywhere in `launch_stage_inner`'s path, this second
   744	    /// call would fail with the identical block error the first call just
   745	    /// produced — instead it must succeed, and exactly one
   746	    /// `self_dogfood_stale_blocked` event (the first call's) must exist for
   747	    /// this phase afterward.
   748	    ///
   749	    /// Also re-asserts WR-02 on the first call's persisted event: the
   750	    /// `reason` field stays a bare, path-free label even though the
   751	    /// returned `CliError` (terminal-only) still names the worktree path.
   752	    ///
   753	    /// Guarded under `ENV_MUTEX` (999.38-class flake): drives
   754	    /// `worktree_staleness_fixture`'s unguarded real `git` subprocesses AND
   755	    /// mutates `PATH` for the stubbed `claude` binary.
   756	    #[test]
   757	    fn mid_run_stage_transition_does_not_readjudicate_staleness() {
   758	        let _guard = env_lock();
   759	
   760	        let (outer, worktree_path, embedded_commit) = worktree_staleness_fixture();
   761	        let project_root = outer.path().join("project");
   762	        std::fs::write(
   763	            project_root.join("Cargo.toml"),
   764	            "[workspace]\nmembers = [\"crates/devflow-core\", \"crates/devflow-cli\"]\n",
   765	        )
   766	        .unwrap();
   767	        assert!(is_self_dogfood_workspace(&project_root));
   768	
   769	        // On top of the fixture's two committed "ahead" commits, leave an
   770	        // UNCOMMITTED build-affecting edit in the worktree too. This makes
   771	        // `combined_staleness`'s dirty-flag arm independently reach `Stale`
   772	        // (`tree_has_modified_build_inputs` sees a modified `.rs` file) even
   773	        // when a call site's `embedded_commit` is unrelated to this
   774	        // fixture's own throwaway history — which is exactly what the REAL
   775	        // production call sites use (`env!("DEVFLOW_BUILD_COMMIT")`, this
   776	        // binary's own build commit, not this fixture's). Without this, the
   777	        // RED discrimination check below (reverting Task 1's deletion)
   778	        // would silently classify `Indeterminate` via a foreign-SHA
   779	        // ancestry lookup and never actually reproduce the pre-fix block.
   780	        std::fs::write(
   781	            worktree_path.join("src/lib.rs"),
   782	            "// wt uncommitted dirty change (not committed)\n",
   783	        )
   784	        .unwrap();
   785	
   786	        let phase = PhaseId::new(94);
   787	        let mut state = State::new(phase, AgentKind::Claude, Mode::Auto, project_root.clone());
   788	        state.stage = Stage::Code;
   789	        state.worktree_path = Some(worktree_path.clone());
   790	        // 31-03: Code is the stage widened to the `stream-json` transport, so
   791	        // the `launch_stage_inner` call in part 2 below passes the D-15
   792	        // delivery-canary gate. Recording an already-`Confirmed` outcome keeps
   793	        // this test measuring what it was written to measure — that the
   794	        // STALENESS check is not re-adjudicated mid-run — instead of failing on
   795	        // an unrelated guard. The canary's own refusal path is covered by
   796	        // `pipeline_launch::tests::launch_stage_inner_refuses_at_code_when_the_canary_cannot_confirm`.
   797	        state.canary = Some(devflow_core::canary::CanaryOutcome::Confirmed);
   798	
   799	        // 1. The `start`-shaped adjudication: called directly, exactly the
   800	        // way `commands::start` now calls it — once, before any stage is
   801	        // launched. The Phase 16 protection must still fire on a fresh
   802	        // start.
   803	        let err =
   804	            enforce_build_staleness(&project_root, &state, &embedded_commit, false).unwrap_err();
   805	        let message = err.to_string();
   806	        assert!(
   807	            message.contains(&worktree_path.display().to_string()),
   808	            "block message must name the worktree that was actually evaluated: {message}"
   809	        );
   810	        assert!(
   811	            !message.contains(&project_root.display().to_string()),
   812	            "block message must not name project_root when a worktree was evaluated: {message}"
   813	        );
   814	        let blocked_event = devflow_core::events::last_event_for_phase(&project_root, phase)
   815	            .expect(
   816	                "the start-shaped adjudication must record an event before returning the error",
   817	            );
   818	        assert_eq!(blocked_event["event"], "self_dogfood_stale_blocked");
   819	        assert_eq!(blocked_event["reason"], "stale_build_blocked");
   820	        assert_eq!(blocked_event["worktree"], true);
  1520	
  1521	        assert_eq!(
  1522	            embedded_commit_is_stale(root, &embedded_commit),
  1523	            Staleness::Fresh,
  1524	            "a docs-only strict-ancestor range must not hard-block (999.29)"
  1525	        );
  1526	        assert_eq!(
  1527	            combined_staleness(root, &embedded_commit, false),
  1528	            Staleness::Fresh
  1529	        );
  1530	    }
  1531	
  1532	    /// 21d/D-07: real-change protection preserved — a mixed range that
  1533	    /// touches BOTH a doc (`.planning/x.md`) AND a NESTED `.rs` file
  1534	    /// (`crates/devflow-cli/src/main.rs`, proving nested-path routing
  1535	    /// through `affects_compiled_binary`, not just a top-level `.rs`) must
  1536	    /// still read `Stale` (Phase 16 false-evidence protection preserved).
  1537	    #[test]
  1538	    fn mixed_range_docs_and_source_is_stale() {
  1539	        let dir = tempfile::tempdir().unwrap();
  1540	        let root = dir.path();
  1541	        let git = |args: &[&str]| {
  1542	            assert!(
  1543	                devflow_core::test_support::git_command(root)
  1544	                    .args(args)
  1545	                    .output()
  1546	                    .unwrap()
  1547	                    .status
  1548	                    .success(),
  1549	                "git {args:?} failed"
  1550	            );
  1551	        };
  1552	        git(&["init", "-q"]);
  1553	        git(&["config", "user.email", "t@e.st"]);
  1554	        git(&["config", "user.name", "t"]);
  1555	        git(&["config", "commit.gpgsign", "false"]);
  1556	        git(&["config", "core.hooksPath", "/dev/null"]);
  1557	
  1558	        std::fs::create_dir_all(root.join("crates/devflow-cli/src")).unwrap();
  1559	        std::fs::write(
  1560	            root.join("crates/devflow-cli/src/main.rs"),
  1561	            "fn main() {}\n",
  1562	        )
  1563	        .unwrap();
  1564	        git(&["add", "."]);
  1565	        git(&["commit", "-q", "-m", "base"]);
  1566	        let embedded_commit = run_git_stdout(root, &["rev-parse", "HEAD"])
  1567	            .expect("rev-parse HEAD")
  1568	            .trim()
  1569	            .to_string();
  1570	
  1571	        // One intervening commit touches BOTH a doc and a nested .rs file.
  1572	        std::fs::create_dir_all(root.join(".planning")).unwrap();
  1573	        std::fs::write(root.join(".planning/x.md"), "docs\n").unwrap();
  1574	        std::fs::write(
  1575	            root.join("crates/devflow-cli/src/main.rs"),
  1576	            "fn main() { /* changed */ }\n",
  1577	        )
  1578	        .unwrap();
  1579	        git(&["add", "."]);
  1580	        git(&["commit", "-q", "-m", "docs + nested source"]);
  1581	
  1582	        assert_eq!(
  1583	            embedded_commit_is_stale(root, &embedded_commit),
  1584	            Staleness::Stale,
  1585	            "a mixed docs+source range must still hard-block (real-change protection preserved)"
  1586	        );
  1587	        assert_eq!(
  1588	            combined_staleness(root, &embedded_commit, false),
  1589	            Staleness::Stale
  1590	        );
  1591	    }
  1592	
  1593	    /// 21d/D-07 (Codex + OpenCode LOW): the stated-but-previously-untested
  1594	    /// fail-toward-Stale safety posture. Forces `git diff --name-only` to
  1595	    /// fail over the ancestry range while leaving `git merge-base
  1596	    /// --is-ancestor` (pure commit-graph traversal, no tree access) able to
  1597	    /// succeed: the embedded commit's root TREE object is deleted from the
  1598	    /// local object store while its COMMIT object stays intact. A git
  1599	    /// failure in the ancestry arm must never read as a false `Fresh`.
  1600	    #[test]
  1601	    fn git_error_range_fails_toward_stale() {
  1602	        let dir = tempfile::tempdir().unwrap();
  1603	        let root = dir.path();
  1604	        let git = |args: &[&str]| {
  1605	            assert!(
  1606	                devflow_core::test_support::git_command(root)
  1607	                    .args(args)
  1608	                    .output()
  1609	                    .unwrap()
  1610	                    .status
    35	/// lives on the config write, in `pipeline_launch::auto_chain_flag_eligible`.
    36	///
    37	/// Named rather than inlined so the three command strings that must carry it
    38	/// (Code, and `fix_prompt`'s two `execute-phase` arms) cannot drift apart, and
    39	/// so a reader of any one of them can find this explanation.
    40	const AUTO_CHAIN_PRESERVING_FLAG: &str = "--auto";
    41	
    42	/// The completion contract every agent must honor as its final message.
    43	pub const COMPLETION_PROTOCOL: &str = "\
    44	## Completion Protocol (REQUIRED)\n\
    45	\n\
    46	When all work is done, your FINAL message must be exactly:\n\
    47	\n\
    48	DEVFLOW_RESULT: {\"status\": \"success\"}\n\
    49	\n\
    50	If something prevents completion:\n\
    51	\n\
    52	DEVFLOW_RESULT: {\"status\": \"failed\", \"reason\": \"specific explanation\"}\n\
    53	\n\
    54	DevFlow reads this line to decide whether the stage succeeded. \
    55	Output nothing after it.";
    56	
    57	/// The data a stage wants rendered, with NO agent-specific syntax.
    58	///
    59	/// This is the de-Claude-ification artifact (999.31 / 37-01): the old
    60	/// `Stage::gsd_command()` returned a `/gsd-*` slash-command string that
    61	/// `prompt.rs` interpolated identically for every agent. `StageIntent` instead
    62	/// carries the stage's *data* (phase, fix kind, review angles), and each
    63	/// adapter's `render_prompt` turns that data into its own instruction — Claude
    64	/// and OpenCode render the legacy slash-command text byte-for-byte, Codex
    65	/// renders a Codex-native instruction with no `/gsd-*` string.
    66	#[derive(Debug, Clone, PartialEq, Eq)]
    67	pub enum StageIntent {
    68	    Define {
    69	        phase: PhaseId,
    70	    },
    71	    Plan {
    72	        phase: PhaseId,
    73	    },
    74	    Code {
    75	        phase: PhaseId,
    76	        fix: Option<FixType>,
    77	    },
    78	    Validate {
    79	        phase: PhaseId,
    80	    },
    81	    Ship {
    82	        phase: PhaseId,
    83	        review_angles: Vec<String>,
    84	    },
    85	}
    86	
    87	impl StageIntent {
    88	    /// The stage this intent drives.
    89	    pub fn stage(&self) -> Stage {
    90	        match self {
    91	            StageIntent::Define { .. } => Stage::Define,
    92	            StageIntent::Plan { .. } => Stage::Plan,
    93	            StageIntent::Code { .. } => Stage::Code,
    94	            StageIntent::Validate { .. } => Stage::Validate,
    95	            StageIntent::Ship { .. } => Stage::Ship,
    96	        }
    97	    }
    98	
    99	    /// Build the intent for a stage with no fix and default review angles
   100	    /// (callers that need a project-local review-angle override use
   310	        — this run is headless and no operator is available to answer \
   311	        interactive questions. Do NOT modify any existing planning \
   312	        artifacts.\n\
   313	        \n\
   314	        {COMPLETION_PROTOCOL}"
   315	    )
   316	}
   317	
   318	/// Build the prompt for a stage of a phase.
   319	pub fn stage_prompt(stage: Stage, phase: PhaseId) -> String {
   320	    stage_prompt_with_project(stage, phase, None)
   321	}
   322	
   323	/// Build a stage prompt with project-local configuration applied.
   324	///
   325	/// The CLI uses this entry point after resolving the canonical project root;
   326	/// library callers that have no project context keep using [`stage_prompt`]
   327	/// and receive built-in defaults.
   328	pub fn stage_prompt_for_project(stage: Stage, phase: PhaseId, project_root: &Path) -> String {
   329	    stage_prompt_with_project(stage, phase, Some(project_root))
   330	}
   331	
   332	/// The Code stage's dedicated prompt.
   333	///
   334	/// The Code arm ONLY carries [`AUTO_CHAIN_PRESERVING_FLAG`] (D-04/D-05, 35.1-01
   335	/// Pitfall 1): `execute-phase.md` wipes `workflow._auto_chain_active` at the top
   336	/// of every invocation whose `$ARGUMENTS` lacks this token, which would clear
   337	/// the flag DevFlow just set before `checkpoint_handling` ever reads it.
   338	fn code_stage_prompt(phase: PhaseId) -> String {
   339	    let command = format!(
   340	        "{} {AUTO_CHAIN_PRESERVING_FLAG}",
   341	        gsd_command_for(Stage::Code, phase)
   342	    );
   343	    format!(
   344	        "Run the GSD workflow command for this stage:\n\n    {command}\n\n\
   345	        ## Advisory incremental self-review\n\
   346	        \n\
   347	        After each plan or wave lands, perform a quick, shallow self-check \
   348	        for doc accuracy, leaked data, CI/build correctness, and \
   349	        external-state claims. Record any drift in the working output and \
   350	        continue execution; the authoritative review happens during Ship. \
   351	        This check must not pause execution or request human input.\n\
   352	        \n\
   353	        {COMPLETION_PROTOCOL}"
   354	    )
   355	}
   356	
   357	/// Render a [`StageIntent`] as the legacy Claude/OpenCode slash-command text.
   358	///
   359	/// This is the byte-identical renderer: Claude and OpenCode produce exactly
   360	/// what `stage_prompt` produced before the migration (CONTEXT D-01 zero
   361	/// regression). It lives here — not in the adapters — so the two agents cannot
   362	/// drift apart, and the per-stage snapshot tests pin it.
   363	pub fn render_claude_style(intent: &StageIntent) -> String {
   364	    match intent {
   365	        StageIntent::Define { phase } => define_stage_prompt(*phase),
   366	        StageIntent::Plan { phase } => idempotent_stage_prompt(*phase),
   367	        StageIntent::Code { phase, fix: None } => code_stage_prompt(*phase),
   368	        StageIntent::Code {
   369	            phase,
   370	            fix: Some(fix),
   371	        } => fix_prompt(*fix, *phase),
   372	        StageIntent::Validate { phase } => validate_stage_prompt(*phase),
   373	        StageIntent::Ship {
   374	            phase,
   375	            review_angles,
   376	        } => ship_stage_prompt(*phase, review_angles),
   377	    }
   378	}
   379	
   380	/// Render a [`StageIntent`] as a workflow-reference instruction for agents that
   381	/// cannot receive the legacy `/gsd-*` slash command (Codex, Pi). The instruction
   382	/// points at the GSD workflow file to follow, carries the `--auto` token where
   383	/// the workflow requires it, and states the completion contract. Contains NO
   384	/// GSD slash command.
   385	/// Render a [`StageIntent`] for an agent that cannot receive the legacy
   386	/// `/gsd-*` slash command (Codex, Pi). Each stage's *contract* is preserved —
   387	/// Validate verdict, Ship review gate, Define no-op, Plan idempotency — but the
   388	/// instruction references the workflow file under `workflow_root` (a per-driver
   389	/// path) instead of naming a slash command.
   390	pub fn render_workflow_style(intent: &StageIntent, workflow_root: &str) -> String {
   391	    match intent {
   392	        // D-14: Define is a no-op for every agent — `define_stage_prompt`
   393	        // already carries no slash command, so it is shared verbatim.
   394	        StageIntent::Define { phase } => define_stage_prompt(*phase),
   395	        StageIntent::Plan { phase } => workflow_plan_prompt(*phase, workflow_root),
   396	        StageIntent::Code { phase, fix } => workflow_code_prompt(*phase, *fix, workflow_root),
   397	        StageIntent::Validate { phase } => workflow_validate_prompt(*phase, workflow_root),
   398	        StageIntent::Ship {
   399	            phase,
   400	            review_angles,
   401	        } => workflow_ship_prompt(*phase, review_angles, workflow_root),
   402	    }
   403	}
   404	
   405	fn workflow_plan_prompt(phase: PhaseId, workflow_root: &str) -> String {
   406	    let artifact = "PLAN.md";
   407	    let padded = phase.padded();
   408	    format!(
   409	        "First check whether this stage's deliverable already exists:\n\
   410	        \n\
   411	        ls .planning/phases/{padded}-*/{padded}-*{artifact} 2>/dev/null\n\
   412	        \n\
   413	        - If it EXISTS: the stage's work is already done. Do NOT run the \
   414	        workflow, do NOT ask for input, and do NOT modify the existing \
   415	        artifacts. Your FINAL message must be exactly:\n\
   416	        \n\
   417	        DEVFLOW_RESULT: {{\"status\": \"success\"}}\n\
   418	        \n\
   419	        - If it does NOT exist: read and follow the GSD workflow file at \
   420	        {workflow_root}/plan-phase.md for phase {phase}.\n\
   421	        \n\
   422	        {COMPLETION_PROTOCOL}"
   423	    )
   424	}
   425	
   426	fn workflow_code_prompt(phase: PhaseId, fix: Option<FixType>, workflow_root: &str) -> String {
   427	    match fix {
   428	        Some(FixType::AuditFix) => format!(
   429	            "Read and follow the GSD workflow file at {workflow_root}/audit-fix.md for \
   430	            phase {phase}.\n\n{COMPLETION_PROTOCOL}"
   431	        ),
   432	        Some(FixType::GapsOnly) => format!(
   433	            "Read and follow the GSD workflow file at {workflow_root}/execute-phase.md for \
   434	            phase {phase} --auto --gaps-only. The `--auto` and `--gaps-only` flags are part \
   435	            of the workflow invocation and must be preserved verbatim.\n\n{COMPLETION_PROTOCOL}"
   436	        ),
   437	        Some(FixType::FullExecute) | None => format!(
   438	            "Read and follow the GSD workflow file at {workflow_root}/execute-phase.md for \
   439	            phase {phase} --auto. The `--auto` flag is part of the workflow invocation and \
   440	            must be preserved verbatim.\n\n\
   441	            ## Advisory incremental self-review\n\
   442	            \n\
   443	            After each plan or wave lands, perform a quick, shallow self-check \
   444	            for doc accuracy, leaked data, CI/build correctness, and \
   445	            external-state claims. Record any drift in the working output and \
   446	            continue execution; the authoritative review happens during Ship. \
   447	            This check must not pause execution or request human input.\n\
   448	            \n\
   449	            {COMPLETION_PROTOCOL}"
   450	        ),
   451	    }
   452	}
   453	
   454	fn workflow_validate_prompt(phase: PhaseId, workflow_root: &str) -> String {
   455	    format!(
   456	        "Read and follow the GSD workflow file at {workflow_root}/validate-phase.md for \
   457	        phase {phase}.\n\n{VALIDATE_VERDICT_CONTRACT}"
   458	    )
   459	}
   460	
   461	fn workflow_ship_prompt(phase: PhaseId, review_angles: &[String], workflow_root: &str) -> String {
   462	    let review_angles = review_angles
   463	        .iter()
   464	        .map(|angle| format!("- {angle}"))
   465	        .collect::<Vec<_>>()
   466	        .join("\n");
   467	    format!(
   468	        "Run the Ship stage in two steps:\n\
   469	        \n\
