  2044	        Some((phase, agent)) => {
  2045	            format!(" — phase {}, agent {agent}", phase.trim_start_matches('0'))
  2046	        }
  2047	        None => format!(" — phase {}", rest.trim_start_matches('0')),
  2048	    }
  2049	}
