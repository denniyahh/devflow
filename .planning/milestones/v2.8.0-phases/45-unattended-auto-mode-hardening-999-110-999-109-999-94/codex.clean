   217	fn source_read_env_vars(source: &str) -> Vec<String> {
   218	    let all = extract_tokens(source, "DEVFLOW_", |ch| {
   219	        ch.is_ascii_uppercase() || ch == '_' || ch.is_ascii_digit()
   220	    });
   221	    all.into_iter()
   222	        .filter(|token| {
   223	            source.contains(&format!("std::env::var(\"{token}\""))
   224	                || source.contains(&format!("std::env::var_os(\"{token}\""))
   225	                || source.contains(&format!("env_value(\"{token}\""))
   226	        })
   227	        .collect()
   228	}
   229	
   230	fn source_contains_path_shape(source: &str, token: &str) -> bool {
   231	    let fragments: Vec<_> = token
   232	        .split(|ch: char| !ch.is_ascii_alphanumeric())
   233	        .filter(|part| part.len() >= 3 && !matches!(*part, "devflow" | "phase" | "NN"))
   234	        .collect();
   235	    !fragments.is_empty() && fragments.iter().all(|fragment| source.contains(fragment))
   236	}
