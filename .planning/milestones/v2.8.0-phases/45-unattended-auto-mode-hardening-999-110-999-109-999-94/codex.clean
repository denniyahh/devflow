  2038	/// Turn a worktree dir name like `phase-07-claude` into ` — phase 7, agent claude`.
  2039	fn describe_worktree_dir(name: &str) -> String {
  2040	    let Some(rest) = name.strip_prefix("phase-") else {
  2041	        return String::new();
  2042	    };
  2043	    match rest.split_once('-') {
  2044	        Some((phase, agent)) => {
  2045	            format!(" — phase {}, agent {agent}", phase.trim_start_matches('0'))
  2046	        }
  2047	        None => format!(" — phase {}", rest.trim_start_matches('0')),
  2048	    }
  2049	}
