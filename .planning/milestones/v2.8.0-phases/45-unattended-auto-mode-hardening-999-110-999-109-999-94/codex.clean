    95	
    96	/// Repository helper bound to a project root.
    97	#[derive(Debug, Clone)]
    98	pub struct GitFlow {
    99	    root: PathBuf,
   100	    config: GitFlowConfig,
   101	}
   102	
   103	/// Summary of a feature branch for the `devflow list` command.
   104	#[derive(Debug, Clone)]
   105	pub struct BranchInfo {
   106	    /// Branch name (e.g. "feature/phase-05").
   107	    pub name: String,
   108	    /// Number of commits this branch has that develop doesn't.
   109	    pub ahead: usize,
   110	    /// Number of commits develop has that this branch doesn't.
   111	    pub behind: usize,
   112	    /// ISO-8601 date of the last commit on this branch.
   113	    pub last_commit: String,
   114	}
   115	
   116	impl GitFlow {
   117	    /// Create a git-flow helper for a project root, using the hardcoded
   118	    /// git-flow constants (`main`, `develop`, `feature/`).
   119	    pub fn new(root: impl AsRef<Path>) -> Self {
   120	        Self {
   121	            root: root.as_ref().to_path_buf(),
   122	            config: GitFlowConfig::default(),
   123	        }
   124	    }
   125	
   126	    /// Create a feature branch from the develop branch.
   127	    ///
   128	    /// Returns an error if the branch already exists (use
   129	    /// [`Self::feature_start_force`] to overwrite).
   130	    pub fn feature_start(&self, phase: PhaseId) -> Result<String, GitError> {
   131	        let branch = format!("{}phase-{}", self.config.feature_prefix, phase.padded());
   132	        info!("creating feature branch: {branch}");
   133	        self.git(["checkout", &self.config.develop])?;
   134	        self.git(["checkout", "-b", &branch])?;
   135	        Ok(branch)
   136	    }
   137	
   138	    /// Create or reset a feature branch, overwriting it if it already exists.
   139	    pub fn feature_start_force(&self, phase: PhaseId) -> Result<String, GitError> {
   140	        let branch = format!("{}phase-{}", self.config.feature_prefix, phase.padded());
   141	        warn!("force-creating feature branch: {branch}");
   142	        self.git(["checkout", &self.config.develop])?;
   143	        self.git(["checkout", "-B", &branch])?;
   144	        Ok(branch)
   145	    }
     1	//! Multi-phase orchestration: spawning several phases concurrently, each in
     2	//! its own worktree (`parallel`).
     3	
     4	use devflow_core::config::{DEVELOP, FEATURE_PREFIX};
     5	use devflow_core::git::GitFlow;
     6	use devflow_core::mode::Mode;
     7	use devflow_core::state::AgentKind;
     8	use devflow_core::worktree;
     9	use std::path::{Path, PathBuf};
    10	
    11	use crate::CliError;
    12	use crate::commands::start;
    13	use devflow_core::phase_id::PhaseId;
    14	
    15	/// Create the phase worktree at `.worktrees/phase-NN/` on `feature/phase-NN`.
    16	pub(crate) fn ensure_phase_worktree(
    17	    project_root: &Path,
    18	    phase: PhaseId,
    19	    force: bool,
    20	) -> Result<PathBuf, CliError> {
    21	    let wt = worktree::phase_path(project_root, phase);
    22	    let branch = format!("{FEATURE_PREFIX}phase-{padded}", padded = phase.padded());
    23	
    24	    if force {
    25	        if wt.exists() {
    26	            worktree::remove(project_root, &wt, true)?;
    27	        }
    28	        let _ = GitFlow::new(project_root).delete_branch(&branch, true);
    29	    }
    30	
    31	    match worktree::add(project_root, &wt, &branch, DEVELOP, true) {
    32	        Ok(()) => Ok(wt),
    33	        Err(devflow_core::worktree::WorktreeError::Exists(path)) => {
    34	            Err(CliError::Message(format!(
    35	                "worktree already exists at {} — use --force to recreate it",
    36	                path.display()
    37	            )))
    38	        }
    39	        Err(err) => Err(err.into()),
    40	    }
    41	}
    42	
    43	// ---------------------------------------------------------------------------
    44	// parallel
    45	// ---------------------------------------------------------------------------
    46	
    47	/// Parse `--phases` and optional `--agents` into positional (phase, agent)
    48	/// pairs. Agents default to `claude` when fewer are given than phases; an error
    49	/// is returned when more agents than phases are supplied.
    50	fn parse_phase_agent_pairs(
    51	    phases: &str,
    52	    agents: Option<&str>,
    53	) -> Result<Vec<(PhaseId, AgentKind)>, CliError> {
    54	    let phases: Vec<PhaseId> = phases
    55	        .split(',')
    56	        .map(|p| p.trim())
    57	        .filter(|p| !p.is_empty())
    58	        .map(|p| {
    59	            p.parse::<PhaseId>()
    60	                .map_err(|err| CliError::Message(err.to_string()))
    61	        })
    62	        .collect::<Result<_, _>>()?;
    63	    if phases.is_empty() {
    64	        return Err(CliError::Message("no phases given".into()));
    65	    }
    66	
    67	    let agents: Vec<AgentKind> = match agents {
    68	        Some(list) => list
    69	            .split(',')
    70	            .map(|a| a.trim())
    71	            .filter(|a| !a.is_empty())
    72	            .map(|a| {
    73	                a.parse::<AgentKind>()
    74	                    .map_err(|err| CliError::Message(err.to_string()))
    75	            })
    76	            .collect::<Result<_, _>>()?,
    77	        None => Vec::new(),
    78	    };
    79	    if agents.len() > phases.len() {
    80	        return Err(CliError::Message(format!(
    81	            "got {} agents for {} phases — provide at most one agent per phase",
    82	            agents.len(),
    83	            phases.len()
    84	        )));
    85	    }
    86	
    87	    Ok(phases
    88	        .into_iter()
    89	        .enumerate()
    90	        .map(|(i, phase)| (phase, agents.get(i).copied().unwrap_or(AgentKind::Claude)))
    91	        .collect())
    92	}
    93	
    94	/// Spawn one monitored worktree run per phase, concurrently.
    95	pub(crate) fn parallel(
    96	    project_root: &Path,
    97	    phases: &str,
    98	    agents: Option<&str>,
    99	    mode: Mode,
   100	    force: bool,
   101	) -> Result<(), CliError> {
   102	    let pairs = parse_phase_agent_pairs(phases, agents)?;
   103	    println!("launching {} phase(s) in parallel worktrees", pairs.len());
   104	    for (phase, agent) in pairs {
   105	        println!("\n=== phase {phase} ({agent}) ===");
   106	        // Worktree mode keeps each run isolated so the phases run together.
   107	        // `devflow parallel` has no `--yes-ship` flag of its own (D-05: the
   108	        // pre-authorization must be typed per invocation on `devflow
   109	        // start`), so every phase it launches keeps the routine gated Ship
   110	        // behavior — `false` here changes nothing about `parallel`'s
   111	        // existing behavior.
   112	        //
   113	        // The trailing `false` is D-11's legacy-launch opt-out, off for the
   114	        // same reason and one stronger: `parallel` is precisely the multi-run
   115	        // shape whose delegated work the legacy path orphans (999.64). An
   116	        // operator who genuinely wants it can still set
   117	        // `DEVFLOW_CLAUDE_LEGACY_LAUNCH`, which `start` reads per phase.
   118	        start(
   119	            project_root,
   120	            phase,
   121	            agent,
   122	            mode,
   123	            force,
   124	            true,
   125	            false,
   126	            None,
   127	            false,
   128	            false,
   129	        )?;
   130	    }
   131	    Ok(())
   132	}
   133	
   134	pub(crate) fn retry_after_from_reason(reason: Option<&str>) -> String {
   135	    reason
   136	        .and_then(|s| s.strip_prefix("rate limited until "))
   137	        .unwrap_or("unknown")
   138	        .to_string()
   139	}
   140	
   198	pub(crate) fn start(
   199	    project_root: &Path,
   200	    phase: PhaseId,
   201	    agent: AgentKind,
   202	    mode: Mode,
   203	    force: bool,
   204	    worktree: bool,
   205	    dry_run: bool,
   206	    until: Option<Stage>,
   207	    yes_ship: bool,
   208	    legacy_claude_launch: bool,
   209	) -> Result<(), CliError> {
   210	    // 999.78/A-11: NOT a bare `State::new`. See
   211	    // `fresh_state_carrying_phase_failures` for why one field survives a
   212	    // forced restart and every other counter does not.
   213	    let mut state = fresh_state_carrying_phase_failures(project_root, phase, agent, mode);
   214	    state.stop_until = until;
   215	    // The only assignment in the crate that ever sets `yes_ship` to a
   216	    // non-default value. Provenance (D-12, `28-CONTEXT.md`): the typed
   217	    // `--yes-ship` CLI flag OR a standing `yes_ship = true` in
   218	    // `devflow.toml`, combined here with logical OR since the flag has no
   219	    // negative form. Combined before the first `save_state` below, so the
   220	    // persisted authorization exists before the detached monitor that will
   221	    // later consult it is ever spawned. `run_gate_with_timeout` must never
   222	    // re-derive this from `state` itself — see its own comment.
   223	    let config_yes_ship = config::yes_ship(project_root);
   224	    // D-12's compensating control: a standing default is never silent. Only
   225	    // fires when config alone supplied the authorization — a typed flag
   226	    // needs no explanation of where it came from.
   227	    if config_yes_ship && !yes_ship {
   228	        println!(
   229	            "note: Ship gate pre-authorized by devflow.toml (yes_ship = true) — see D-12, 28-CONTEXT.md"
   230	        );
   231	    }
   232	    state.yes_ship = yes_ship || config_yes_ship;
   233	
   234	    // D-11's opt-out (31-04), combined on the same shape and for the same
   235	    // reasons as `yes_ship` directly above: OR-ed with an environment override
   236	    // rather than replacing it, before the first `save_state` below so the
   237	    // persisted value exists before any detached monitor consults it, and with
   238	    // a notice when the environment ALONE supplied it — a standing default is
   239	    // never a silent one.
   240	    if crate::pipeline_launch::apply_legacy_launch_opt_out(&mut state, legacy_claude_launch) {
   241	        println!(
   242	            "note: legacy Claude launch forced by DEVFLOW_CLAUDE_LEGACY_LAUNCH \
   243	             (D-11, 31-CONTEXT.md) — a persisted default is never a silent one"
   244	        );
   245	    }
   246	
   247	    if dry_run {
   248	        print_dry_run(&state);
   249	        return Ok(());
   250	    }
   251	
   252	    // 14-CR-05: fail on a missing agent binary BEFORE any branch/worktree is
   253	    // scaffolded (launch_stage re-checks for the advance-time launch paths).
   254	    ensure_agent_binary(agent_program(agent))?;
   255	
   256	    // 25e (999.51/D-18a): before even asking whether phase N is reachable,
   257	    // make sure the base branch itself is current with its remote. A stale
   258	    // base is the single most common cause of a phase heading appearing
   259	    // absent — 999.51 recorded local `develop` sitting 21 commits behind
   260	    // `origin/develop` while the phase heading existed only on the remote —
   261	    // and the DANGEROUS variant is silent: a stale local `develop` that
   262	    // still happens to carry the heading passes the reachability guard
   263	    // below and forks a green run from stale code. Ordering here is
   264	    // load-bearing for the same reason the comment below already gives for
   265	    // the Codex leg: running reachability first would misdiagnose the cause
   266	    // (base is stale) as the symptom (phase not found). `ensure_base_ref_current`
   267	    // fast-forwards a safely-behind base and proceeds unattended, or refuses
   268	    // loudly on divergence / an unsafe fast-forward (see that function's own
   269	    // doc comment for the full decision).
   270	    ensure_base_ref_current(project_root, DEVELOP)?;
   271	
   272	    // 23f (gap closure, 23-12): refuse before ANY git mutation when phase N
   273	    // is not reachable from DEVELOP — the exact branch `ensure_phase_worktree`
   274	    // passes to `worktree::add` as `start_point`, so the branch this guard
   275	    // inspects and the branch the run forks can never disagree. Precedes
   276	    // BOTH fork paths (`ensure_phase_worktree` below, and `GitFlow::feature_start`
   277	    // in the `else` branch), and precedes the Codex leg deliberately: if
   278	    // phase N is absent from `develop` entirely, "no CONTEXT.md on develop"
   279	    // is a narrower and misleading diagnosis of the same root fact.
   280	    ensure_phase_reachable_on_base(project_root, phase, DEVELOP)?;
   281	
   282	    // 999.106 driver-driven pre-flight: whether a fresh headless run can pass
   283	    // a stage is declared by the driver's `interactivity_mode`, not a
   284	    // hardcoded `agent == Codex`. A `RequiresExistingArtifact` Define must
   285	    // have CONTEXT.md on develop; a `RequiresExistingArtifact` Plan warns
   286	    // without a PLAN.md. Fail in one second with instructions instead of after
   287	    // a burned agent run and a dead-end gate. Checked on `develop` (the
   288	    // branch worktrees fork from), so the result does not depend on what the
   289	    // primary checkout happens to have checked out.
   290	    let driver = agents::driver_for(agent);
   291	    if driver.interactivity_mode(Stage::Define)
   292	        == agents::InteractivityMode::RequiresExistingArtifact
   293	        && !phase_artifact_on_develop(project_root, phase, "-CONTEXT.md")
   294	    {
   295	        return Err(CliError::Message(format!(
   296	            "phase {phase} has no CONTEXT.md on develop, and {} cannot run an \
   297	             interactive discussion headless. Run /gsd-discuss-phase {phase} \
   298	             interactively first (any agent), or use --agent claude.",
   299	            driver.name()
   300	        )));
   301	    }
   302	    if driver.interactivity_mode(Stage::Plan) == agents::InteractivityMode::RequiresExistingArtifact
   303	        && !phase_artifact_on_develop(project_root, phase, "-PLAN.md")
   304	    {
   305	        println!(
   306	            "warning: phase {phase} has no PLAN.md on develop — headless {} \
   307	             planning is untested and may need input; pre-writing plans is safer",
   308	            driver.name()
   309	        );
   310	    }
   311	
   312	    // Pre-start divergence check: runs on current HEAD before any git
   313	    // mutation. WR-10 (13-REVIEW.md): only meaningful for the --no-worktree
   314	    // (branch-in-place) flow, where `start` actually branches from the main
   315	    // checkout's current HEAD. In worktree mode (the default) the agent's
   316	    // work always forks fresh from `develop` via `worktree::add`, independent
   317	    // of whatever happens to be checked out in the main repo — checking the
   318	    // main checkout's divergence there is unrelated to what's about to
   319	    // happen and can either hard-fail on a stale unrelated branch or
   320	    // silently no-op if the main checkout happens to be on develop.
   321	    if !worktree && let Ok((_ahead, behind)) = GitFlow::new(project_root).divergence_from_develop()
   322	    {
   323	        if behind > 50 {
   324	            return Err(CliError::Message(format!(
   325	                "develop is {behind} commits ahead — your branch is too far behind. \
   326	                 Rebase onto develop first, or use --force to override."
   327	            )));
   328	        }
   329	        if behind > 10 {
   330	            println!("warning: develop is {behind} commits ahead — consider rebasing first");
   331	        }
   332	    }
   333	
   334	    if worktree {
   335	        let wt = ensure_phase_worktree(project_root, phase, force)?;
   336	        println!(
   337	            "created worktree: {} (branch {FEATURE_PREFIX}phase-{padded})",
   338	            wt.display(),
   339	            padded = phase.padded(),
   340	        );
   341	        state.worktree_path = Some(wt);
   342	    } else {
   343	        let git = GitFlow::new(project_root);
   344	        let result = if force {
   345	            git.feature_start_force(phase)
   346	        } else {
   347	            git.feature_start(phase)
   348	        };
   349	        match result {
   350	            Ok(branch) => println!("created feature branch: {branch}"),
   351	            Err(err) => {
   352	                if !force {
   353	                    return Err(CliError::Message(format!(
   354	                        "{err}\nUse --force to overwrite the existing branch."
   355	                    )));

