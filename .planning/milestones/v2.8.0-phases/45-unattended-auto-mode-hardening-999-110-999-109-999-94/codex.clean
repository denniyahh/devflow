   520	
   521	/// D-21: the `workflow_started` event payload, including build provenance —
   522	/// factored out of `start()` so the payload shape is directly unit-testable
   523	/// without spawning a real agent (`start()` calls `launch_stage` immediately
   524	/// after emitting this event).
   525	fn workflow_started_payload(state: &State) -> serde_json::Value {
   526	    serde_json::json!({
   527	        "agent": state.agent.to_string(),
   528	        "mode": state.mode.to_string(),
   529	        "worktree": state.worktree_path.as_ref().map(|p| p.display().to_string()),
   530	        "version": env!("CARGO_PKG_VERSION"),
   531	        "commit": env!("DEVFLOW_BUILD_COMMIT"),
   532	        "dirty": env!("DEVFLOW_BUILD_DIRTY"),
   533	        // WR-02: filename only, never the full path (leaks home dir/username
   534	        // into OPERATIONS.md's tail-and-paste file); to_string_lossy (not
   535	        // to_str) so non-UTF-8 names still yield a string, not null.
   536	        "exe_path": std::env::current_exe()
   537	            .ok()
   538	            .and_then(|p| p.file_name().map(|n| n.to_string_lossy().into_owned())),
   539	    })
   540	}
