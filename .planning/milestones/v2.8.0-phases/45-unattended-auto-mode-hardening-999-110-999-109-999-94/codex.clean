[workspace]
resolver = "2"
members = [
    "crates/devflow-core",
    "crates/devflow-cli", "tmp_test",
]

[workspace.package]
version = "2.11.0"
edition = "2024"
license = "MIT OR Apache-2.0"
repository = "https://github.com/denniyahh/devflow"
description = "An opinionated CLI for AI-driven development workflow automation"
authors = ["Dennis Kim <denniyahh@gmail.com>"]
readme = "README.md"
keywords = ["cli", "workflow", "automation", "git", "devops"]
categories = ["command-line-utilities", "development-tools"]

[workspace.dependencies]
devflow-core = { path = "crates/devflow-core", version = "2.11.0" }
serde = { version = "1", features = ["derive"] }
# `preserve_order` is load-bearing, not a preference: `devflow_core::gsd_config`
# round-trips the operator's `.planning/config.json` through `serde_json::Value`
# to set one key, and without this feature that round trip re-sorts every
# top-level key alphabetically — turning a tracked, committed file into a
# full-file diff on every single stage launch (35.1-01).
serde_json = { version = "1", features = ["preserve_order"] }
toml = "1"
clap = { version = "4", features = ["derive"] }
thiserror = "2"
tracing = "0.1"
tracing-subscriber = "0.3"

[workspace.lints.clippy]
dbg_macro = "warn"
todo = "warn"
unimplemented = "warn"

