   959	
   960	/// The tail of [`launch_stage_inner`]: clear the stale monitor pid, validate
   961	/// the agent binary, archive the prior capture, spawn the monitor, and
   962	/// record the launch. Extracted (28-03, Task 2) so
   963	/// [`relaunch_checkpoint_session`] can share this EXACT tail for a
   964	/// checkpoint auto-decide resume — a resume is a continuation of the same
   965	/// stage's agent run, not a fresh stage entry, so it must not duplicate this
   966	/// bookkeeping nor drift from it over time.
   967	///
   968	/// Emits no events beyond `capture_archived` and `stage_launched` — a
   969	/// checkpoint resume is distinguished from an ordinary launch by its own
   970	/// separate `checkpoint_auto_decided` event, emitted by the caller BEFORE
  1000	    // trade-off notes.
  1001	    if let Some(stamp) = agent_result::archive_phase_files(
  1002	        &state.project_root,
  1003	        state
  1004	            .worktree_path
  1005	            .as_deref()
  1006	            .unwrap_or(&state.project_root),
  1007	        state.phase,
  1008	        capture_retention(&state.project_root),
  1009	    )
  1010	    .map_err(|err| {
  1011	        CliError::Message(format!(
  1012	            "could not archive phase {} capture before rollover: {err}",
  1013	            state.phase
  1014	        ))
  1015	    })? {
  1016	        events::emit(
  1017	            &state.project_root,
  1018	            state.phase,
  1019	            "capture_archived",
  1020	            serde_json::json!({
  1021	                "stage": archived_stage.unwrap_or(state.stage).to_string(),
  1022	                "to_stage": state.stage.to_string(),
  1023	                "stamp": stamp,
  1024	            }),
  1025	        );
  1026	    }
  1027	    let pid = monitor::spawn_monitor(state, program, args, extra_env, launch)
  1028	        .map_err(|err| CliError::Message(format!("could not spawn monitor: {err}")))?;
  1029	    // `transition()` calls `workflow::save_state` BEFORE `launch_stage`, so a
  1030	    // pid recorded only in memory here is lost unless it is written again
  1031	    // (18b).
  1032	    state.monitor_pid = Some(pid);
  1033	    workflow::save_state(state)?;
  1034	    match devflow_core::ship::consume_cron_instructions(&state.project_root, state.phase) {
  1035	        Ok(Some(path_kind)) => {
  1036	            let path_kind = match path_kind {
  1037	                devflow_core::ship::CronInstructionPathKind::PerPhase => "per-phase",
  1038	                devflow_core::ship::CronInstructionPathKind::Legacy => "legacy",
  1039	                devflow_core::ship::CronInstructionPathKind::Both => "both",
  1040	            };

