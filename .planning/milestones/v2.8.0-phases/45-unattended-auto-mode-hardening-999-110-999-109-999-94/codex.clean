  2051	pub(crate) fn list(project_root: &Path) -> Result<(), CliError> {
  2052	    let git = GitFlow::new(project_root);
  2053	    let branches = git.list_feature_branches()?;
  2054	    if branches.is_empty() {
  2055	        println!("no open feature branches");
  2056	        return Ok(());
  2057	    }
  2058	    println!(
  2059	        "{:<25} {:>6} {:>7}  LAST COMMIT",
  2060	        "BRANCH", "AHEAD", "BEHIND"
  2061	    );
  2062	    for b in &branches {
  2063	        println!(
  2064	            "{:<25} {:>6} {:>7}  {}",
  2065	            b.name, b.ahead, b.behind, b.last_commit
  2066	        );
  2067	    }
  2068	    Ok(())
  2069	}
  2070	
  2071	fn print_open_branches(project_root: &Path) {
  2072	    let git = GitFlow::new(project_root);
  2073	    let branches = match git.list_feature_branches() {
  2074	        Ok(b) => b,
  2075	        Err(_) => return,
  2076	    };
  2077	    if branches.is_empty() {
  2078	        return;
  2079	    }
  2080	    println!("\nopen branches:");
  2081	    for b in &branches {
  2082	        let staleness = if b.behind > 0 {
  2083	            format!(" ({} behind develop)", b.behind)
  2084	        } else {
  2085	            String::new()
  2086	        };
  2087	        println!("  {} — {} ahead{staleness}", b.name, b.ahead);
  2088	    }
  2089	}
