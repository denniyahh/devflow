ch[1])) { console.log('valid'); } else { console.log('invalid'); }\n887\t  \" 2>/dev/null)\n888\t  \n889\t  if [ \"$HAS_STATUS\" = \"valid\" ]; then\n890\t    echo \"REVIEW.md created at ${REVIEW_PATH}\"\n891\t    \n892\t    if [ \"$COMMIT_DOCS\" = \"true\" ]; then\n893\t      gsd_run query commit \\\n894\t        \"docs(${PADDED_PHASE}): add code review report\" \\\n895\t        --files \"${REVIEW_PATH}\"\n896\t    fi\n897\t  else\n898\t    echo \"Warning: REVIEW.md exists but has invalid or missing frontmatter (no status field).\"\n899\t    echo \"Agent may have produced malformed output. Not committing. Review manually: ${REVIEW_PATH}\"\n900\t  fi\n901\telse\n902\t  echo \"Warning: Agent completed but REVIEW.md not found at ${REVIEW_PATH}. This may indicate an agent issue.\"\n903\t  echo \"No REVIEW.md to commit. Please retry with /gsd-code-review ${PHASE_ARG}\"\n904\tfi\n905\t```\n906\t</step>\n907\t\n908\tIf `section_manifest` is `null` or `\"dispatch-fix\"` is in its `included` list: read and execute `gsd-core/workflows/code-review/steps/dispatch-fix.md`. Otherwise skip — do not read the file; proceed to `present_results`.\n909\t\n910\t<step name=\"present_results\">\n911\tRead the REVIEW.md YAML frontmatter to extract finding counts.\n912\t\n913\tExtract frontmatter between `---` delimiters first to avoid matching values in the review body:\n914\t\n915\t```bash\n916\t# Extract only the YAML frontmatter block (between first two --- lines)\n917\tFRONTMATTER=$(REVIEW_PATH=\"${REVIEW_PATH}\" node -e \"\n918\t  const fs = require('fs');\n919\t  const content = fs.readFileSync(process.env.REVIEW_PATH, 'utf-8');\n920\t  const match = content.replace(/\\r\\n/g, '\\n').match(/^---\\n([\\s\\S]*?)\\n---/);\n921\t  if (match) process.stdout.write(match[1]);\n922\t\" 2>/dev/null)\n923\t\n924\t# Parse fields from frontmatter only (not full file)\n925\tSTATUS=$(echo \"$FRONTMATTER\" | grep \"^status:\" | cut -d: -f2 | xargs)\n926\tFILES_REVIEWED=$(echo \"$FRONTMATTER\" | gr