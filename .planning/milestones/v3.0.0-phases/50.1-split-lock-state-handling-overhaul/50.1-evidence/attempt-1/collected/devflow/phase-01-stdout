_ENV_FILE\" 2>/dev/null || true; fi\n27\tPHASE_ARG=\"${1}\"\n28\t\n29\t# Parse all code-review flags into a structured IR via code-review-flags.cjs.\n30\t# This is the canonical flag-parsing surface — do not replicate inline bash parsing\n31\t# for --fix/--all/--auto here; the module handles all flag extraction and implication\n32\t# logic (e.g., --all and --auto imply --fix). Resolved BEFORE the init call below so\n33\t# the section-manifest gate forwards the RESOLVED (post-implication) fix decision, not\n34\t# just a literal --fix token check.\n35\t# gsd-resolve-lib begin code-review-flags.cjs (#5640): load helpers from the installed runtime, not the cwd\n36\t_gsd_lib_probe=\"code-review-flags.cjs\"\n37\t_gsd_rt=\"${RUNTIME_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}\"\n38\t_gsd_gr=\"$(command -v gsd_run 2>/dev/null || true)\"\n39\tcase \"$_gsd_gr\" in /*) ;; *) _gsd_gr=\"\" ;; esac # a gsd_run shell function prints its bare name: not a path\n40\t[ -n \"$_gsd_gr\" ] && _gsd_gr=\"$(dirname \"$(node -p \"require('fs').realpathSync(process.argv[1])\" \"$_gsd_gr\" 2>/dev/null || echo \"$_gsd_gr\")\")/lib\"\n41\tGSD_LIB_DIR=\"\"\n42\t_gsd_pick() { for _gsd_d; do if [ -n \"$_gsd_d\" ] && [ -f \"$_gsd_d/$_gsd_lib_probe\" ]; then GSD_LIB_DIR=\"$_gsd_d\"; return 0; fi; done; return 1; }\n43\t_gsd_pick \"${GSD_TOOLS:+${GSD_TOOLS%/*}/lib}\" \"$_gsd_rt/gsd-core/bin/lib\" \"$_gsd_rt/.claude/gsd-core/bin/lib\" \"$_gsd_rt/.codex/gsd-core/bin/lib\" \"$_gsd_gr\" \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/gsd-core/bin/lib\" \"${CODEX_HOME:-$HOME/.codex}/gsd-core/bin/lib\" || true\n44\tif [ -z \"$GSD_LIB_DIR\" ]; then echo \"ERROR: code-review-flags.cjs not found in the GSD runtime. Looked in: ${GSD_TOOLS:+${GSD_TOOLS%/*}/lib, }${_gsd_rt}/gsd-core/bin/lib (and its .claude and .codex forms), ${_gsd_gr:-next to gsd_run (not on PATH)}, ${CLAUDE_CONFIG_DIR:-$HOME/.claude}/gsd-core/bin/lib, ${CODEX_HOME:-$HOME/.codex}/gsd-core/bin/lib. Reinstall: npx -y @opengsd/gsd-core@latest --claude --local\" >&2; exit 1; fi\n45\texport GSD_LIB_DIR\n46\t# gsd-resolve-lib end\n47\tFLAGS_JSON=$(node -e \"\n48\t  const { parseCodeReviewFlags } = require(require('path').join(process.env.GSD_LIB_DIR, 'code-review-flags.cjs'));\n49\t  const flags = parseCodeReviewFlags(process.argv.slice(1));\n50\t  process.stdout.write(JSON.stringify(flags));\n51\t\" -- \"$@\" 2>/dev/null)\n52\t\n53\t# Extract individual flag values from the IR\n54\tFIX_FLAG=$(echo \"$FLAGS_JSON\" | node -e \"process.stdout.write(String(JSON.parse(require('fs').readFileSync('/dev/stdin','utf-8')).fix))\")\n55\tFIX_ALL=$(echo \"$FLAGS_JSON\" | node -e \"process.stdout.write(String(JSON.parse(require('fs').readFileSync('/dev/stdin','utf-8')).all))\")\n56\tFIX_AUTO=$(echo \"$FLAGS_JSON\" | node -e \"process.stdout.write(String(JSON.parse(require('fs').readFileSync('/dev/stdin','utf-8')).auto))\")\n57\tDEPTH_OVERRIDE=$(echo \"$FLAGS_JSON\" | node -e \"process.stdout.write(JSON.parse(require('fs').readFileSync('/dev/stdin','utf-8')).depth)\")\n58\tFILES_OVERRIDE=$(echo \"$FLAGS_JSON\" | node -e \"process.stdout.write(JSON.parse(require('fs').readFileSync('/dev/stdin','utf-8')).files)\")\n59\t\n60\t# Forward the resolved fix decision (--fix itself, or --all/--auto implying it) to\n61\t# init.code-review so section_manifest's flag:--fix gating (dispatch-fix section)\n62\t# matches code-review-flags.cjs's own implication logic rather than a raw token scan.\n63\tFIX_PARAM=\"\"\n64\tif [ \"$FIX_FLAG\" = \"true\" ]; then FIX_PARAM=\"--fix\"; fi\n65\t\n66\tGSD_WS=$(echo \" $GSD_ARGS\" | sed -nE 's/.* --ws +([A-Za-z0-9][A-Za-z0-9._-]*).*/--ws \\1/p' | head -n 1)\n67\tINIT=$(gsd_run query init.code-review ${GSD_WS:+--ws=${GSD_WS##* }} \"${PHASE_ARG}\" $FIX_PARAM)\n68\tif [[ \"$INIT\" == @file:* ]]; then INIT=$(cat \"${INIT#@file:}\"); fi\n69\tAGENT_SKILLS_REVIEWER=$(gsd_run query agent-skills gsd-code-reviewer ${GSD_WS:+--ws=${GSD_WS##* }})\n70\t# #2072: resolve the routed model so model_overrides / models.verification are honored\n71\t# (the resolver maps gsd-code-reviewer → phaseType \"verification\"); thread it below.\n72\tREVIEWER_MODEL=$(gsd_run query resolve-model gsd-code-reviewer --raw)\n73\t```\n74\t\n75\tParse from init JSON: `phase_found`, `phase_dir`, `phase_number`, `phase_name`, `padded_phase`, `commit_docs`, `fallow_enabled`, `fallow_scope`, `fallow_profile`, `fallow_mcp`, `fallow_max_crap`.\n76\t\n77\t**Input sanitization (defense-in-depth):**\n78\t```bash\n79\t# Validate PADDED_PHASE matches the canonical phase-number grammar (src/phase-id.cts): digits,\n80\t# an optional single uppercase letter, then dotted segments (e.g., \"02\", \"03.1\", \"23.1.2\", \"12A\")\n81\tif ! [[ \"$PADDED_PHASE\" =~ ^[0-9]+[A-Z]?(\\.[0-9]+)*$ ]]; then\n82\t  echo \"Error: Invalid phase number format: '${PADDED_PHASE}'. Expected digits with an optional letter suffix (e.g., 02, 03.1, 23.1.2, 12A).\"\n83\t  # Exit workflow\n84\tfi\n85\t```\n86\t\n87\t**Phase validation (before config gate):**\n88\tIf `phase_found` is false, report error and exit:\n89\t```\n90\tError: Phase ${PHASE_ARG} not found. Run /gsd-progress to see available phases.\n91\t```\n92\t\n93\tThis runs BEFORE config gate check so user errors are surfaced immediately regardless of config state.\n94\t\n95\tIf FILES_OVERRIDE is set, split by comma into array:\n96\t```bash\n97\tif [ -n \"$FILES_OVERRIDE\" ]; then\n98\t  IFS=',' read -ra FILES_ARRAY <<< \"$FILES_OVERRIDE\"\n99\tfi\n100\t```\n101\t</step>\n102\t\n103\t<step name=\"check_config_gate\">\n104\tCheck if code review is active via `workflow.code_review` (the capability's on/off toggle — independent of `workflow.code_review_point`, the loop-point selector; a manual invocation must work regardless of which automatic point is currently configured):\n105\t\n106\t```bash\n107\tCODE_REVIEW_ENABLED=$(gsd_run query config-get workflow.code_review --raw 2>/dev/null || echo \"true\")\n108\t```\n109\t\n110\tIf `CODE_REVIEW_ENABLED` is not `\"true\"`:\n111\t```\n112\tCode review skipped (code-review capability inactive)\n113\t```\n114\tExit workflow.\n115\t\n116\tDefault is active (`workflow.code_review` schema default is `true`) — only skip when explicitly disabled. This check runs AFTER phase validation so invalid phase errors are shown first.\n117\t</step>\n118\t\n119\t<step name=\"compute_file_scope\">\n120\tThree-tier scoping with explicit precedence:\n121\t\n122\tCompute the phase's last review commit, if any. This narrows Tiers 2 and 3 below to what\n123\tchanged since that review (wave-scoped reviews under `workflow.code_review_point=execute:wave:post`):\n124\t\n125\t```bash\n126\t# #3661: incremental scoping — when this phase has a prior review, later tiers\n127\t# narrow to what changed since it (wave-scoped reviews under\n128\t# workflow.code_review_point=execute:wave:post). Empty on a phase's first review\n129\t# (the entire execute:post-default path), in which case Tiers 2 and 3 below are\n130\t# unchanged from today.\n131\tLAST_REVIEW_COMMIT=$(git log --format=%H -1 -- \"${PHASE_DIR}/${PADDED_PHASE}-REVIEW.md\" 2>/dev/null)\n132\t```\n133\t\n134\t**Tier 1 — --files override (highest precedence per D-08):**\n135\t\n136\tIf FILES_OVERRIDE is set (from --files flag):\n137\t```bash\n138\tif [ -n \"$FILES_OVERRIDE\" ]; then\n139\t  REVIEW_FILES=()\n140\t  # #5519: compare the repository root and each resolved path in ONE form. On Windows Git Bash,\n141\t  # `git rev-parse --show-toplevel` (a native program) reports a mixed path (C:/Users/..) while\n142\t  # GNU `realpath` reports an MSYS POSIX path (/c/Users/..); the two never share a prefix, so\n143\t  # every entry looked \"outside\". `cygpath -m` exists exactly where the forms differ and maps both\n144\t  # to the mixed form; elsewhere the value passes through unchanged.\n145\t  _gsd_norm_path() {\n146\t    if command -v cygpath >/dev/null 2>&1; then cygpath -m \"$1\"; else printf '%s' \"$1\"; fi\n147\t  }\n148\t  REPO_ROOT=$(_gsd_norm_path \"$(git rev-parse --show-toplevel 2>/dev/null)\")\n149\t  \n150\t  for file_path in \"${FILES_ARRAY[@]}\"; do\n151\t    # Security: validate path is within repository (prevent path traversal). Compare on a path\n152\t    # boundary: the root itself or anything under \"<root>/\" — a sibling such as \"<root>-other\"\n153\t    # shares the prefix but is not inside.\n154\t    ABS_PATH=$(_gsd_norm_path \"$(realpath -m \"${file_path}\" 2>/dev/null || echo \"${file_path}\")\")\n155\t    # Fail closed on two shapes that cannot be trusted: an empty root (git failed, so nothing can be\n156\t    # \"inside\" it) and a path that still holds \"..\" segments (a resolved path never does, so it was\n157\t    # not resolved — no GNU realpath).\n158\t    if [ -z \"$REPO_ROOT\" ] || [[ \"$ABS_PATH\" == */../* || \"$ABS_PATH\" == */.. ]] || [[ \"$ABS_PATH\" != \"$REPO_ROOT\" && \"$ABS_PATH\" != \"$REPO_ROOT\"/* ]]; then\n159\t      echo \"Error: File path outside repository, skipping: ${file_path}\"\n160\t      continue\n161\t    fi\n162\t    \n163\t    # Validate path exists (relative to repo root)\n164\t    if [ -f \"${REPO_ROOT}/${file_path}\" ] || [ -f \"${file_path}\" ]; then\n165\t      REVIEW_FILES+=(\"$file_path\")\n166\t    else\n167\t      echo \"Warning: File not found, skipping: ${file_path}\"\n168\t    fi\n169\t  done\n170\t  \n171\t  echo \"File scope: ${#REVIEW_FILES[@]} files from --files override\"\n172\tfi\n173\t```\n174\t\n175\tSkip SUMMARY/git scoping entirely when --files is provided.\n176\t\n177\t**Tier 2 — SUMMARY.md extraction (primary per D-01):**\n178\t\n179\tIf --files NOT provided:\n180\t```bash\n181\tif [ -z \"$FILES_OVERRIDE\" ]; then\n182\t  SUMMARIES=$(ls \"${PHASE_DIR}\"/*-SUMMARY.md 2>/dev/null)\n183\t  REVIEW_FILES=()\n184\t\n185\t  # Keep the literal heredoc outside command substitution: Bash 3.2 (the\n186\t  # system Bash on macOS) reparses heredoc bodies nested directly in $(...).\n187\t  extract_summary_files() {\n188\t    node - \"$1\" 2>/dev/null <<'NODE'\n189\t    const fs = require('fs');\n190\t    const content = fs.readFileSync(process.argv[2], 'utf-8');\n191\t    const match = content.replace(/\\r\\n/g, '\\n').match(/^---\\n([\\s\\S]*?)\\n---/);\n192\t    if (!match) { process.exit(0); }\n193\t    const yaml = match[1];\n194\t    const files = [];\n195\t    let inSection = null;\n196\t    for (const line of yaml.split('\\n')) {\n197\t      if (/^\\s+created:/.test(line)) { inSection = 'created'; continue; }\n198\t      if (/^\\s+modified:/.test(line)) { inSection = 'modified'; continue; }\n199\t      if (/^\\s*[\\w-]+:/.test(line) && !/^\\s*-/.test(line)) { inSection = null; continue; }\n200\t      if (inSection && /^\\s+-\\s+(.+)/.test(line)) {\n201\t        let raw = line.match(/^\\s+-\\s+(.+)/)[1].trim();\n202\t        raw = raw.replace(/^['\"]|['\"]$/g, '');\n203\t        raw = raw.replace(/\\s+\\([^)]*\\)\\s*$/, '');\n204\t        raw = raw.split(/\\s+—\\s/)[0].trim();\n205\t        // #2666: accept root-level paths (no `/`) and known extensionless build\n206\t        // files, not only nested paths with a trailing extension. The pre-fix\n207\t        // guard required BOTH a directory separator AND a trailing dot-extension,\n208\t        // which silently dropped every repository-root file (Dockerfile,\n209\t        // renovate.json, AGENTS.md, package.json, .gitlab-ci.yml, …) and every\n210\t        // extensionless build file anywhere in the tree (**/Dockerfile, **/Makefile).\n211\t        // Prose bullets are rejected by the known-filename / has-extension\n212\t        // distinction, with the post-processing existence check (`[ -f ]`) as a\n213\t        // backstop — a prose string is never a real file on disk.\n214\t        const KNOWN_EXTENSIONLESS_BUILD_FILES = new Set([\n215\t          'dockerfile', 'containerfile', 'makefile', 'justfile', 'procfile',\n216\t        ]);\n217\t        const hasExtension = /\\.[A-Za-z0-9]+$/.test(raw);\n218\t        const basename = raw.split('/').pop().toLowerCase();\n219\t        if (hasExtension || KNOWN_EXTENSIONLESS_BUILD_FILES.has(basename)) {\n220\t          files.push(raw);\n221\t        }\n222\t      }\n223\t    }\n224\t    if (files.length) console.log(files.join('\\n'));\n225\tNODE\n226\t  }\n227\t  \n228\t  if [ -n \"$SUMMARIES\" ]; then\n229\t    # Rewrapped through unquoted command substitution (gsd-core#4109): a bare\n230\t    # `$VAR` word-splits under bash but not zsh, collapsing every element onto\n231\t    # one iteration there.\n232\t    for summary in $(printf '%s' \"$SUMMARIES\"); do\n233\t      # #3661: skip a SUMMARY.md unchanged since the phase's last review — this\n234\t      # summary's plan was already reviewed. No-op (every summary is \"changed\") when\n235\t      # LAST_REVIEW_COMMIT is empty. Fails OPEN on any git error (file stays in scope)\n236\t      # — never silently drop a file because a git command errored.\n237\t      if [ -n \"$LAST_REVIEW_COMMIT\" ] && git diff --quiet \"${LAST_REVIEW_COMMIT}\" HEAD -- \"$summary\" 2>/dev/null; then\n238\t        continue\n239\t      fi\n240\t\n241\t      # Extract key_files.created and key_files.modified using node for reliable YAML parsing\n242\t      # This avoids fragile awk parsing that breaks on indentation differences\n243\t      EXTRACTED=$(extract_summary_files \"$summary\")\n244\t      \n245\t      # Add extracted files to REVIEW_FILES array\n246\t      if [ -n \"$EXTRACTED\" ]; then\n247\t        while IFS= read -r file; do\n248\t          if [ -n \"$file\" ]; then\n249\t            REVIEW_FILES+=(\"$file\")\n250\t          fi\n251\t        done <<< \"$EXTRACTED\"\n252\t      fi\n253\t    done\n254\t    \n255\t    if [ ${#REVIEW_FILES[@]} -eq 0 ]; then\n256\t      echo \"Warning: SUMMARY artifacts found but contained no file paths. Falling back to the phase evaluation scope.\"\n257\t    fi\n258\t  fi\n259\tfi\n260\t```\n261\t\n262\t**Tier 3 — Phase evaluation scope (per D-02, #5164) and SUMMARY/scope cross-check (per #2666):**\n263\t\n264\tIf no SUMMARY.md files found OR no files extracted from them, fall back to the phase's evaluation scope.\n265\tAdditionally, whenever the resolver returns a scope, cross-check the SUMMARY scope against it and warn\n266\tabout (then add) any in-scope files the SUMMARY extractor did not surface — so a partial SUMMARY result\n267\tcan no longer silently mask the rest of the phase.\n268\t\n269\tThe scope is computed by the ONE resolver, `check evaluation-scope` (ADR-5057 §4, #5164) — this step\n270\tderives no commit range of its own. The resolver returns the UNION of the phase's own commits' file\n271\tsets (the `## Task Commits` rows of the phase's SUMMARYs), restricted to commits reachable from `HEAD`\n272\t(a commit that lives only on another branch is named, never counted), with planning artifacts and\n273\tlockfiles excluded. A range (`base..HEAD`) is deliberately not used: it keeps every interleaved\n274\tnon-phase commit in its window (#3926, #4563). The resolver also reports, by name rather than by\n275\tcount, what the union dropped: `outsideUnion` (changed in the phase window by other commits) and\n276\t`unreachable` (task commits not on this branch). When the union is empty — a phase with no SUMMARY,\n277\tno task rows, or only planning paths — the resolver widens to the phase-directory range and says so\n278\t(`status: degraded`, `reason`); an unreadable phase or repository is `unresolvable`, never an empty\n279\tscope that reports success. Its `rangeBase` (the parent of the commit that first added the phase\n280\tdirectory, or `LAST_REVIEW_COMMIT` when a prior review exists — #3661) is `DIFF_BASE`, kept only for\n281\tthe reviewer lanes that need an anchor sha.\n282\t```bash\n283\t# Exit 69 (UNAVAILABLE) is the resolver saying \"could not look\" (`status: unresolvable`): its JSON\n284\t# carries the reason and is kept. Any other non-zero status means the command did not run: no JSON.\n285\tSCOPE_RC=0\n286\tSCOPE_JSON=$(gsd_run check evaluation-scope --phase \"${PADDED_PHASE}\" ${LAST_REVIEW_COMMIT:+--since \"$LAST_REVIEW_COMMIT\"} --raw 2>/dev/null) || SCOPE_RC=$?\n287\tif [ \"$SCOPE_RC\" -ne 0 ] && [ \"$SCOPE_RC\" -ne 69 ]; then SCOPE_JSON=\"\"; fi\n288\t# One field of the resolver's JSON; arrays print one element per line, an absent field prints nothing.\n289\tscope_field() {\n290\t  printf '%s' \"$SCOPE_JSON\" | node -e 'let s=\"\";process.stdin.on(\"data\",d=>s+=d).on(\"end\",()=>{try{const v=JSON.parse(s)[process.argv[1]];process.stdout.write(Array.isArray(v)?v.join(\"\\n\"):v==null?\"\":String(v))}catch{process.exit(1)}})' \"$1\" 2>/dev/null\n291\t}\n292\tSCOPE_STATUS=$(scope_field status); [ -n \"$SCOPE_STATUS\" ] || SCOPE_STATUS=\"unresolvable\"\n293\tSCOPE_REASON=$(scope_field reason)\n294\tSCOPE_SOURCE=$(scope_field source)\n295\tDIFF_BASE=$(scope_field rangeBase)\n296\tSCOPE_FILES=$(scope_field files)\n297\t\n298\tif [ \"$SCOPE_STATUS\" != \"resolved\" ]; then\n299\t  echo \"Warning: evaluation scope is ${SCOPE_STATUS}${SCOPE_REASON:+ (${SCOPE_REASON})}; the file scope below comes from wider evidence or is unavailable.\"\n300\tfi\n301\tSCOPE_OUTSIDE=$(scope_field outsideUnion)\n302\tif [ -n \"$SCOPE_OUTSIDE\" ]; then\n303\t  echo \"Changed in the phase window by commits that are NOT this phase's task commits (not in scope):\"\n304\t  printf '%s\\n' \"$SCOPE_OUTSIDE\" | sed 's/^/  - /'\n305\tfi\n306\tSCOPE_UNREACHABLE=$(scope_field unreachable)\n307\tif [ -n \"$SCOPE_UNREACHABLE\" ]; then\n308\t  echo \"Task commits not reachable from HEAD (another branch, or dropped by a rebase):\"\n309\t  printf '%s\\n' \"$SCOPE_UNREACHABLE\" | sed 's/^/  - /'\n310\tfi\n311\tSCOPE_MISSING=$(scope_field missingOnDisk)\n312\tif [ -n \"$SCOPE_MISSING\" ]; then\n313\t  echo \"Scoped paths that no longer exist on disk (not reviewed):\"\n314\t  printf '%s\\n' \"$SCOPE_MISSING\" | sed 's/^/  - /'\n315\tfi\n316\t\n317\tif [ ${#REVIEW_FILES[@]} -eq 0 ]; then\n318\t  # Full fallback (per D-02): SUMMARY scoping yielded nothing.\n319\t  if [ -n \"$SCOPE_FILES\" ]; then\n320\t    while IFS= read -r file; do\n321\t      [ -n \"$file\" ] && REVIEW_FILES+=(\"$file\")\n322\t    done <<< \"$SCOPE_FILES\"\n323\t\n324\t    echo \"File scope: ${#REVIEW_FILES[@]} files from ${SCOPE_SOURCE} (base: ${DIFF_BASE:-<none>})\"\n325\t  else\n326\t    # Fail closed — the resolver found no reviewable files. Do not use arbitrary HEAD~N.\n327\t    echo \"Warning: No evaluation scope found for '${PADDED_PHASE}' (${SCOPE_STATUS}${SCOPE_REASON:+: ${SCOPE_REASON}}). Cannot determine reliable scope.\"\n328\t    echo \"Use --files flag to specify files explicitly: /gsd-code-review ${PHASE_ARG} --files=file1,file2,...\"\n329\t  fi\n330\telif [ -z \"$FILES_OVERRIDE\" ] && [ -n \"$SCOPE_FILES\" ]; then\n331\t  # #4460: gated on FILES_OVERRIDE being unset — without this, REVIEW_FILES is\n332\t  # already non-empty under --files (Tier 1 filled it), so this elif was\n333\t  # reached anyway and the #2666 cross-check below appended the whole phase\n334\t  # scope onto an explicit user-supplied file list, contradicting \"Skip\n335\t  # SUMMARY/git scoping entirely when --files is provided\" and Tier 2's\n336\t  # own --files guard.\n337\t  # #2666 cross-check: SUMMARY yielded a non-empty (possibly partial) scope.\n338\t  # Warn about — and add — any in-scope files the SUMMARY extractor did not surface,\n339\t  # so a partial result can no longer silently ship an incomplete review scope.\n340\t\n341\t  # Exact whole-line membership (portable — bash 3.2 has no associative arrays). grep -Fxq\n342\t  # matches the WHOLE line, so a short basename (e.g. root `Dockerfile`) does NOT\n343\t  # substring-match a longer scoped path (e.g. `docker/Dockerfile`).\n344\t  MISSING_FROM_SUMMARY=()\n345\t  while IFS= read -r file; do\n346\t    [ -z \"$file\" ] && continue\n347\t    if printf '%s\\n' \"${REVIEW_FILES[@]}\" | grep -Fxq -- \"$file\" 2>/dev/null; then\n348\t      : # already scoped\n349\t    else\n350\t      MISSING_FROM_SUMMARY+=(\"$file\"); REVIEW_FILES+=(\"$file\")\n351\t    fi\n352\t  done <<< \"$SCOPE_FILES\"\n353\t\n354\t  if [ ${#MISSING_FROM_SUMMARY[@]} -gt 0 ]; then\n355\t    echo \"Warning: SUMMARY scope was missing ${#MISSING_FROM_SUMMARY[@]} in-scope file(s) the evaluation scope surfaced; adding them to the review scope:\"\n356\t    printf '  - %s\\n' \"${MISSING_FROM_SUMMARY[@]}\"\n357\t  fi\n358\tfi\n359\t```\n360\t\n361\t**Post-processing (all tiers):**\n362\t\n363\t1. **Expand tilde paths:** SUMMARY.md `key-files` entries may record a `~/...`-prefixed path. Bash only tilde-expands a literal `~` written in source text, never one arriving as the value of an already-expanded variable, so every later `[ -f \"$file\" ]` check must see a real, expanded path or it misclassifies the file as deleted.\n364\t```bash\n365\tEXPANDED_FILES=()\n366\tfor file in \"${REVIEW_FILES[@]}\"; do\n367\t  case \"$file\" in\n368\t    \"~/\"*) file=\"${HOME}${file#\\~}\" ;;\n369\t  esac\n370\t  EXPANDED_FILES+=(\"$file\")\n371\tdone\n372\tREVIEW_FILES=(\"${EXPANDED_FILES[@]}\")\n373\t```\n374\t\n375\t2. **Apply exclusions (per D-03):** Remove paths matching planning artifacts\n376\t```bash\n377\tFILTERED_FILES=()\n378\tfor file in \"${REVIEW_FILES[@]}\"; do\n379\t  # Skip planning directory and specific artifacts\n380\t  if [[ \"$file\" == .planning/* ]] || \\\n381\t     [[ \"$file\" == ROADMAP.md ]] || \\\n382\t     [[ \"$file\" == STATE.md ]] || \\\n383\t     [[ \"$file\" == *-SUMMARY.md ]] || \\\n384\t     [[ \"$file\" == *-VERIFICATION.md ]] || \\\n385\t     [[ \"$file\" == *-PLAN.md ]]; then\n386\t    continue\n387\t  fi\n388\t  FILTERED_FILES+=(\"$file\")\n389\tdone\n390\tREVIEW_FILES=(\"${FILTERED_FILES[@]}\")\n391\t```\n392\t\n393\t3. **Filter deleted files:** Remove paths that don't exist on disk, and name each one (#5164) — a count hides whether the dropped file held the phase's entire deliverable\n394\t```bash\n395\tEXISTING_FILES=()\n396\tDELETED_FILES=()\n397\tDELETED_COUNT=0\n398\tfor file in \"${REVIEW_FILES[@]}\"; do\n399\t  if [ -f \"$file\" ]; then\n400\t    EXISTING_FILES+=(\"$file\")\n401\t  else\n402\t    DELETED_COUNT=$((DELETED_COUNT + 1))\n403\t    DELETED_FILES+=(\"$file\")\n404\t  fi\n405\tdone\n406\tREVIEW_FILES=(\"${EXISTING_FILES[@]}\")\n407\t\n408\tif [ $DELETED_COUNT -gt 0 ]; then\n409\t  echo \"Filtered $DELETED_COUNT deleted files from review scope:\"\n410\t  printf '  - %s\\n' \"${DELETED_FILES[@]}\"\n411\tfi\n412\t```\n413\t\n414\t4. **Deduplicate:** Remove duplicate paths (portable — bash 3.2+ compatible, handles spaces in paths)\n415\t```bash\n416\tDEDUPED=()\n417\twhile IFS= read -r line; do\n418\t  [ -n \"$line\" ] && DEDUPED+=(\"$line\")\n419\tdone < <(printf '%s\\n' \"${REVIEW_FILES[@]}\" | sort -u)\n420\tREVIEW_FILES=(\"${DEDUPED[@]}\")\n421\t```\n422\t\n423\t5. **Sort:** Alphabetical sort for reproducible agent input (already sorted by sort -u above)\n424\t\n425\t**Log final scope and warn if large:**\n426\t```bash\n427\tif [ -n \"$FILES_OVERRIDE\" ]; then\n428\t  TIER=\"--files override\"\n429\telif [ -n \"$SUMMARIES\" ] && [ ${#REVIEW_FILES[@]} -gt 0 ]; then\n430\t  TIER=\"SUMMARY.md\"\n431\telse\n432\t  TIER=\"${SCOPE_SOURCE:-evaluation scope}\"\n433\tfi\n434\techo \"File scope: ${#REVIEW_FILES[@]} files from ${TIER}\"\n435\t\n436\t# Warn if file count is very large — may exceed agent context or produce superficial review\n437\tif [ ${#REVIEW_FILES[@]} -gt 50 ]; then\n438\t  echo \"Warning: ${#REVIEW_FILES[@]} files is a large review scope.\"\n439\t  echo \"Consider using --files to narrow scope, or --depth=quick for a faster pass.\"\n440\tfi\n441\t```\n442\t</step>\n443\t\n444\t<step name=\"resolve_depth\">\n445\tDetermine review depth via the path-scoped depth resolver (`code-review-depth.cjs`). This step runs after `compute_file_scope` because rule matching needs the final `REVIEW_FILES` set.\n446\t\n447\t```bash\n448\tCONFIG_DEPTH=$(gsd_run query config-get workflow.code_review_depth --raw 2>/dev/null || echo \"\")\n449\tDEPTH_OVERRIDES=$(gsd_run query config-get workflow.code_review_depth_overrides --default '[]' 2>/dev/null || echo '[]')\n450\tREPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null)\n451\t\n452\t# Files travel on stdin, never argv — a 50+-file scope with long paths approaches the\n453\t# Windows execFileSync 32,767-char argv ceiling; stdin has no such bound.\n454\tDEPTH_PAYLOAD=$(printf '%s\\n' \"${REVIEW_FILES[@]}\" | FLAG_DEPTH=\"$DEPTH_OVERRIDE\" CONFIG_DEPTH=\"$CONFIG_DEPTH\" DEPTH_OVERRIDES=\"$DEPTH_OVERRIDES\" REPO_ROOT=\"$REPO_ROOT\" node -e \"\n455\t  const files = require('fs').readFileSync('/dev/stdin', 'utf-8').split('\\n').filter(Boolean);\n456\t  process.stdout.write(JSON.stringify({\n457\t    flagDepth: process.env.FLAG_DEPTH || '',\n458\t    configDepth: process.env.CONFIG_DEPTH || '',\n459\t    overrides: JSON.parse(process.env.DEPTH_OVERRIDES || '[]'),\n460\t    files,\n461\t    repoRoot: process.env.REPO_ROOT || '',\n462\t  }));\n463\t\")\n464\t\n465\t# gsd-resolve-lib begin code-review-depth.cjs (#5640): load helpers from the installed runtime, not the cwd\n466\t_gsd_lib_probe=\"code-review-depth.cjs\"\n467\t_gsd_rt=\"${RUNTIME_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}\"\n468\t_gsd_gr=\"$(command -v gsd_run 2>/dev/null || true)\"\n469\tcase \"$_gsd_gr\" in /*) ;; *) _gsd_gr=\"\" ;; esac # a gsd_run shell function prints its bare name: not a path\n470\t[ -n \"$_gsd_gr\" ] && _gsd_gr=\"$(dirname \"$(node -p \"require('fs').realpathSync(process.argv[1])\" \"$_gsd_gr\" 2>/dev/null || echo \"$_gsd_gr\")\")/lib\"\n471\tGSD_LIB_DIR=\"\"\n472\t_gsd_pick() { for _gsd_d; do if [ -n \"$_gsd_d\" ] && [ -f \"$_gsd_d/$_gsd_lib_probe\" ]; then GSD_LIB_DIR=\"$_gsd_d\"; return 0; fi; done; return 1; }\n473\t_gsd_pick \"${GSD_TOOLS:+${GSD_TOOLS%/*}/lib}\" \"$_gsd_rt/gsd-core/bin/lib\" \"$_gsd_rt/.claude/gsd-core/bin/lib\" \"$_gsd_rt/.codex/gsd-core/bin/lib\" \"$_gsd_gr\" \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/gsd-core/bin/lib\" \"${CODEX_HOME:-$HOME/.codex}/gsd-core/bin/lib\" || true\n474\tif [ -z \"$GSD_LIB_DIR\" ]; then echo \"ERROR: code-review-depth.cjs not found in the GSD runtime. Looked in: ${GSD_TOOLS:+${GSD_TOOLS%/*}/lib, }${_gsd_rt}/gsd-core/bin/lib (and its .claude and .codex forms), ${_gsd_gr:-next to gsd_run (not on PATH)}, ${CLAUDE_CONFIG_DIR:-$HOME/.claude}/gsd-core/bin/lib, ${CODEX_HOME:-$HOME/.codex}/gsd-core/bin/lib. Reinstall: npx -y @opengsd/gsd-core@latest --claude --local\" >&2; exit 1; fi\n475\texport GSD_LIB_DIR\n476\t# gsd-resolve-lib end\n477\tDEPTH_JSON=$(echo \"$DEPTH_PAYLOAD\" | node -e \"\n478\t  const { resolveCodeReviewDepth } = require(require('path').join(process.env.GSD_LIB_DIR, 'code-review-depth.cjs'));\n479\t  const input = JSON.parse(require('fs').readFileSync('/dev/stdin', 'utf-8'));\n480\t  process.stdout.write(JSON.stringify(resolveCodeReviewDepth(input)));\n481\t\")\n482\t\n483\tDEPTH_OK=$(echo \"$DEPTH_JSON\" | node -e \"process.stdout.write(String(JSON.parse(require('fs').readFileSync('/dev/stdin','utf-8')).ok))\")\n484\t```\n485\t\n486\tThe guard and the extraction it protects must run as one shell control-flow decision — a prose sentence between two fenced blocks is not a guard, since fenced blocks do not share shell state. Anything other than the literal string `true` (including an empty `DEPTH_OK`, which is what a crashed or missing resolver produces) is treated as failure, and the failure branch exits before any extraction can run:\n487\t\n488\t```bash\n489\tif [ \"$DEPTH_OK\" = \"true\" ]; then\n490\t  # Single spawn: emit all seven fields as Unit-Separator-delimited (U+001F) values,\n491\t  # fixed order. Field '\\x1f' (not '\\n') is deliberate: bash's `read` treats '\\n' as\n492\t  # \"IFS whitespace\" and collapses runs of it, silently dropping an empty field (e.g.\n493\t  # DEPTH_MATCHED_RULE_PATH when matchedRule is null) — '\\x1f' is not IFS-whitespace,\n494\t  # so each empty field survives as its own zero-length token. This is safe only\n495\t  # because validateRulePath (src/code-review-depth.cts) rejects any rule path\n496\t  # carrying an interior control character, including U+001F itself — so\n497\t  # DEPTH_MATCHED_RULE_PATH below can never collide with the delimiter. Do not\n498\t  # remove that validation without revisiting this split.\n499\t  DEPTH_FIELDS=$(echo \"$DEPTH_JSON\" | node -e \"\n500\t    const d = JSON.parse(require('fs').readFileSync('/dev/stdin', 'utf-8'));\n501\t    const r = d.matchedRule;\n502\t    process.stdout.write([\n503\t      d.depth,\n504\t      d.source,\n505\t      r ? String(r.index) : '',\n506\t      r ? r.path : '',\n507\t      String(!!d.invalidFlagDepth),\n508\t      String(!!d.invalidConfigDepth),\n509\t      String(!!d.downgraded),\n510\t    ].join('\\x1f'));\n511\t  \")\n512\t  IFS=$'\\x1f' read -r -d '' REVIEW_DEPTH DEPTH_SOURCE DEPTH_MATCHED_RULE_INDEX DEPTH_MATCHED_RULE_PATH \\\n513\t    DEPTH_INVALID_FLAG DEPTH_INVALID_CONFIG DEPTH_DOWNGRADED <<< \"$DEPTH_FIELDS\" || true\n514\t  # <<< always appends a trailing newline to its input; strip it from the last field.\n515\t  DEPTH_DOWNGRADED=\"${DEPTH_DOWNGRADED%$'\\n'}\"\n516\t\n517\t  case \"$DEPTH_SOURCE\" in\n518\t    flag) DEPTH_PROVENANCE=\"from --depth flag\" ;;\n519\t    rule) DEPTH_PROVENANCE=\"matched rule ${DEPTH_MATCHED_RULE_INDEX}: ${DEPTH_MATCHED_RULE_PATH}\" ;;\n520\t    config) DEPTH_PROVENANCE=\"from workflow.code_review_depth\" ;;\n521\t    *) DEPTH_PROVENANCE=\"default\" ;;\n522\t  esac\n523\t  echo \"Review depth: ${REVIEW_DEPTH} (${DEPTH_PROVENANCE})\"\n524\t\n525\t  if [ \"$DEPTH_INVALID_FLAG\" = \"true\" ]; then\n526\t    echo \"Warning: Invalid depth '${DEPTH_OVERRIDE}'. Valid values: quick, standard, deep. Using 'standard'.\"\n527\t  fi\n528\t  if [ \"$DEPTH_INVALID_CONFIG\" = \"true\" ]; then\n529\t    echo \"Warning: Invalid depth '${CONFIG_DEPTH}'. Valid values: quick, standard, deep. Using 'standard'.\"\n530\t  fi\n531\t\n532\t  if [ \"$DEPTH_DOWNGRADED\" = \"true\" ]; then\n533\t    if [ -n \"$DEPTH_MATCHED_RULE_INDEX\" ]; then\n534\t      echo \"Switching from deep to standard depth for large file count (overrides matched rule ${DEPTH_MATCHED_RULE_INDEX}: ${DEPTH_MATCHED_RULE_PATH}).\"\n535\t    else\n536\t      echo \"Switching from deep to standard depth for large file count.\"\n537\t    fi\n538\t  fi\n539\telse\n540\t  # DEPTH_OK is anything but the literal string \"true\" — including empty, which is\n541\t  # what a crashed or missing resolver produces. workflow.code_review_depth_overrides\n542\t  # is misconfigured. Print every collected error — never fall back to a default\n543\t  # depth, since silently reviewing a misconfigured sensitive-path policy at\n544\t  # `standard` is the exact hole this feature closes — then hard-stop before\n545\t  # REVIEW_DEPTH can be read by any later step.\n546\t  echo \"$DEPTH_JSON\" | node -e \"\n547\t    let parsed;\n548\t    try {\n549\t      parsed = JSON.parse(require('fs').readFileSync('/dev/stdin', 'utf-8'));\n550\t    } catch {\n551\t      parsed = {};\n552\t    }\n553\t    const errors = Array.isArray(parsed.errors) ? parsed.errors : [];\n554\t    for (const err of errors) {\n555\t      const parts = [];\n556\t      if (err.ruleIndex !== undefined) parts.push('rule ' + err.ruleIndex);\n557\t      if (err.path !== undefined) parts.push('path \\\"' + err.path + '\\\"');\n558\t      if (err.value !== undefined) parts.push('depth \\\"' + err.value + '\\\"');\n559\t      console.error('Error: workflow.code_review_depth_overrides' + (parts.length ? ' (' + parts.join(', ') + ')' : '') + ': ' + err.reason);\n560\t    }\n561\t  \"\n562\t  echo \"Error: Fix workflow.code_review_depth_overrides and retry.\"\n563\t  echo \"Error: Depth resolution failed (DEPTH_OK=\\\"${DEPTH_OK}\\\"). Halting before agent spawn.\"\n564\t  exit 1\n565\tfi\n566\t```\n567\tThis `if`/`else`/`fi` is the entire guard: unless `DEPTH_OK` is the literal string `true`, the `else` branch prints the errors and `exit 1`s out of the fenced block, so the `DEPTH_FIELDS`/`REVIEW_DEPTH` extraction is never reached and `REVIEW_DEPTH` is never set. Exit workflow. Do NOT spawn agent or create REVIEW.md.\n568\t</step>\n569\t\n570\t<step name=\"check_empty_scope\">\n571\tAn empty `REVIEW_FILES` (#3661) means nothing new to re-review — NOT a phase with no standing findings. #4665: with `--fix` + an existing REVIEW.md, route to `dispatch-fix` (the flag covers \"if REVIEW.md already exists\"):\n572\t\n573\t```bash\n574\tREVIEW_PATH=\"${PHASE_DIR}/${PADDED_PHASE}-REVIEW.md\"\n575\tif [ \"${#REVIEW_FILES[@]}\" -ne 0 ]; then\n576\t  # non-empty scope: no-op\n577\t  true\n578\telif [ \"$FIX_FLAG\" != \"true\" ] || [ ! -f \"${REVIEW_PATH}\" ]; then\n579\t  echo \"No source files changed in phase ${PHASE_ARG}. Skipping review.\"\n580\t  # Exit workflow. Do NOT spawn agent or create REVIEW.md.\n581\t  exit 0\n582\tfi\n583\t```\n584\t\n585\t**`--fix` recovery:** proceed DIRECTLY to `dispatch-fix`, skipping `structural_pre_pass`, `dispatch_reviewer_lanes`, `spawn_reviewer`, `commit_review` — no fresh review, nothing to commit; `code-review-fix.md` resolves the existing REVIEW.md and owns the fix logic. The reviewer agent is not dispatched here.\n586\t</step>\n587\t\n588\t<step name=\"structural_pre_pass\">\n589\tOptional structural cross-module pass powered by fallow.\n590\t\n591\tParse `fallow_enabled`, `fallow_scope`, `fallow_profile`, `fallow_mcp`, `fallow_max_crap` from the init JSON as `FALLOW_ENABLED`, `FALLOW_SCOPE`, `FALLOW_PROFILE`, `FALLOW_MCP`, `FALLOW_MAX_CRAP`. These are resolved once by `init.code-review` at init time — consuming the pre-resolved values here avoids gating this section's own inclusion on a fact its own body would compute (see `state:fallow-enabled` in docs/reference/workflow-fragments.md).\n592\t\n593\tDefaults are fail-closed and opt-in:\n594\t- `enabled=false` (skip entirely)\n595\t- `scope=phase`\n596\t- `profile=standard` (maps to `--max-crap 30`; minimal=50, standard=30, strict=15 — fallow has no native