// DevFlow dev container: pinned Rust toolchain matching rust-toolchain.toml
// (channel = "stable", components = ["clippy", "rustfmt"]), with cargo registry
// and workspace target/ caches persisted across rebuilds.
// Base image tag verified against mcr.microsoft.com/v2/devcontainers/rust/tags/list
// (current published bookworm tag as of 2026-07-17) — pin deliberately; never use
// an unversioned floating tag.
{
  "name": "DevFlow",
  "image": "mcr.microsoft.com/devcontainers/rust:2.0.13-1-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "configureZshAsDefaultShell": true
    }
  },
  "mounts": [
    {
      "source": "devflow-cargo-registry",
      "target": "/usr/local/cargo/registry",
      "type": "volume"
    },
    {
      "source": "devflow-cargo-git",
      "target": "/usr/local/cargo/git",
      "type": "volume"
    },
    {
      "source": "devflow-target-${localWorkspaceFolderBasename}",
      "target": "${containerWorkspaceFolder}/target",
      "type": "volume"
    }
  ],
  // Docker creates fresh named volumes as root; claim writable Cargo volumes for the lifecycle user.
  "postCreateCommand": "sudo chown -R \"$(id -u):$(id -g)\" /usr/local/cargo/registry /usr/local/cargo/git \"${containerWorkspaceFolder}/target\" && git config --global --add safe.directory \"${containerWorkspaceFolder}\" && rustup component add clippy rustfmt && cargo build --workspace",
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "vadimcn.vscode-lldb",
        "tamasfe.even-better-toml",
        "fill-labs.dependi",
        "mutantdino.resourcemonitor"
      ],
      "settings": {
        "rust-analyzer.check.command": "clippy",
        "rust-analyzer.cargo.allTargets": true,
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true
      }
    }
  },
  "remoteUser": "vscode"
}
