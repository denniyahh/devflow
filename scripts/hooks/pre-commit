#!/usr/bin/env bash
# Chains to whatever pre-commit hook was active before this directory was
# installed as core.hooksPath.
#
# `core.hooksPath` replaces the hooks directory wholesale — git consults
# exactly one. So `git config core.hooksPath scripts/hooks` (the install step
# in CONTRIBUTING.md) silently disables any pre-commit a developer already
# relies on: a global secret scanner, or a repo-local .git/hooks/pre-commit.
# Losing a secret scan without being told is a worse failure than the missing
# hook it was traded for, so delegate instead of shadowing.
#
# This is a no-op for anyone without such a hook.
set -euo pipefail

# Refuse to commit directly on the PR-protected branches. `develop` and `main`
# both require changes through a pull request (a repository ruleset rejects a
# direct push), so a commit made here is doomed to be rejected at push time.
# Refusing at the commit — while the changes are still staged and can be carried
# onto a branch with `git switch -c` — saves the round-trip. Deliberately no
# override: there is no legitimate commit on a protected branch, and an override
# variable is exactly what a mistaken commit would reach for.
# Allow automated DevFlow terminal hooks (e.g. VersionBump, ChangelogAppend)
# or explicit escape hatch to complete post-merge finalization.
is_devflow=0
if [ "${DEVFLOW_ALLOW_PROTECTED_COMMIT:-0}" = "1" ] || [ "${DEVFLOW_TERMINAL_HOOK:-0}" = "1" ]; then
    is_devflow=1
else
    cur_pid="$$"
    for _ in 1 2 3 4 5; do
        cur_ppid=$(awk '/PPid:/ {print $2}' "/proc/$cur_pid/status" 2>/dev/null || true)
        if [ -z "$cur_ppid" ] || [ "$cur_ppid" -le 1 ]; then
            break
        fi
        if grep -qE "(devflow|agy|antigravity)" "/proc/$cur_ppid/cmdline" 2>/dev/null; then
            is_devflow=1
            break
        fi
        cur_pid="$cur_ppid"
    done
fi

if [ "$is_devflow" -eq 0 ]; then
    branch="$(git symbolic-ref --short HEAD 2>/dev/null || true)"
    case "$branch" in
        develop | main)
            echo "pre-commit: refusing to commit directly on '$branch'." >&2
            echo "  '$branch' is PR-protected — changes must be made through a pull request," >&2
            echo "  so this commit would be rejected at push time." >&2
            echo "  Create a branch first (your staged changes carry over):" >&2
            echo "      git switch -c feature/<name>   # or release/, fix/, docs/, ..." >&2
            exit 1
            ;;
    esac
fi

# Branch hygiene: personal/agent tooling configuration belongs exclusively on
# `workspace/*` (or `personal/*`) branches. Refuse it on develop, main,
# feature/*, fix/*, chore/*, and release/* branches.
#
# `.planning/` is deliberately NOT in this list. GSD's per-phase worktree
# convention (CLAUDE.md) commits PLAN.md/SUMMARY.md/STATE.md/ROADMAP.md on the
# active feature/phase-N branch as work happens, and isolated per-plan
# executor worktrees fork from that branch's committed HEAD — so `.planning`
# content that never commits there is invisible to them (999.11x). The
# guarantee that `.planning/**` never reaches develop/main is enforced at
# push time instead (scripts/hooks/pre-push), which is the actual boundary
# that matters, not every intermediate commit on a working branch.
current_branch="$(git symbolic-ref --short HEAD 2>/dev/null || true)"
if [ -n "$current_branch" ] && [[ "$current_branch" != workspace/* && "$current_branch" != personal/* ]]; then
    staged_personal="$(git diff --cached --name-only | grep -E '^(\.agents|\.bg-shell|\.claude|\.codex|\.gemini|\.omx|\.opencode|CLAUDE\.md|\.mcp\.json|skills/|skills-lock\.json|\.gsd|\.gsd-backups|\.gsd-id|\.gsd-worktrees|\.devflow|\.worktrees)' || true)"
    if [ -n "$staged_personal" ]; then
        echo "pre-commit: refusing to commit personal/agent artifacts on branch '$current_branch':" >&2
        echo "$staged_personal" | sed 's/^/  /' >&2
        echo "  Personal agent configurations, planning files, and local state belong exclusively" >&2
        echo "  on 'workspace/<handle>' branches. Unstage them before committing to '$current_branch'." >&2
        exit 1
    fi
fi

global_hooks=$(git config --global --get core.hooksPath || true)
if [ -n "$global_hooks" ]; then
  # Expand a leading ~ ourselves; git stores the literal string.
  global_hooks="${global_hooks/#\~/$HOME}"
  if [ -x "$global_hooks/pre-commit" ]; then
    exec "$global_hooks/pre-commit" "$@"
  fi
fi

# No global hooks dir configured — fall back to the repo-local hook that
# core.hooksPath displaced.
repo_hook="$(git rev-parse --git-common-dir)/hooks/pre-commit"
if [ -x "$repo_hook" ]; then
  exec "$repo_hook" "$@"
fi

exit 0
