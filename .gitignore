# Build artifacts
/target
site/
# graphify knowledge-graph output: regenerable, never committed to develop/main.
# `graphify-out/*` rather than `graphify-out/` so a branch that tracks a snapshot
# can still re-include files with `!` (a directory-level ignore cannot be negated).
graphify-out/*

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Agent ephemeral runtime state and caches
**/.claude/scheduled_tasks.lock
**/.claude/scheduled_tasks.json
**/.claude/routines/.state/
**/.claude/worktrees/
**/.claude/checkpoints/
**/.claude/mailbox/
**/.claude/agent-registry.json
**/.claude/agent-memory-local
**/.claude/first-run
**/.claude/assistant-daemon-state.json
**/.claude/settings.local.json

# GSD run-scoped runtime state (session id, PID, timestamps — dead on any
# other checkout the moment it's written; regenerated at the next command).
# `.gsd/*/dispatch-isolation-sentinel.json` is documented as a "run-scoped
# sentinel" (gsd-core references/dispatch-isolation-gate.md, #3045).
# `.planning/milestone.lock` holds `{phase, session, pid, updated_at}` with a
# TTL-based advisory lock (gsd-core milestone-lock.cjs, #3311) — never meant
# to survive a commit. `.planning/state.json` is a best-effort derived
# projection republished at every step boundary (gsd-core state-contract.cjs,
# #3227), "no second answer to any question GSD already answers".
.gsd/
.planning/milestone.lock
.planning/state.json

# Planning, runtime states, and local databases

# DevFlow own state (dogfooding) — per-phase since the 14a refactor
.devflow/state.json
.devflow/state-*.json
.devflow/lock-*
.devflow/phase-*-stdout
.devflow/phase-*-stderr.log
.devflow/phase-*-exit
.devflow/phase-*-agent-pid
.devflow/phase-*-monitor-stop
.devflow/last-ship*.json
.devflow/cron-instructions*.json
.devflow/events.jsonl
.devflow/gates/
.devflow/history/

# Per-checkout DevFlow configuration (`base_branch` and other `devflow.toml`
# keys). It names a checkout's own trunk, so develop never carries one; a
# personal workspace branch may track its own (backlog 999.110).
devflow.toml

# Git worktrees created by `devflow start --worktree` / `parallel` / `sequentagent`
.worktrees/

# Bytecode cache
__pycache__/

# Graphify knowledge graph: not tracked on any branch since 2026-11-08. Each
# checkout keeps its own graphify-out/, refreshed after commits by the
# operator's global graphify auto-refresh hook; a new phase worktree is seeded
# from the main checkout's graph, which keeps the LLM-derived semantic nodes
# that a code-only `graphify update .` cannot rebuild. (Until 2026-11-08 a
# snapshot was tracked here; refreshing it meant an 18 MB commit and a
# four-minute secret scan, and it went stale between phases.)
graphify-out/
# byte-identical duplicate of graphify-out/graph.json
.planning/graphs/

# insta snapshot scratch (47-CONTEXT.md D-14). `*.snap.new` is what insta writes
# beside a baseline when a snapshot is missing or mismatches under its local
# default mode — transient, never reviewed, never committed. `*.snap` itself
# stays TRACKED on purpose: the committed baseline IS the reviewable artifact,
# so every prompt wording change must appear in the PR diff. Never widen this
# rule to cover the baselines.
*.snap.new

# External-review raw traces (regenerable, hundreds of KB each)
.planning/phases/**/codex.err
.planning/phases/**/codex.clean
.planning/phases/**/agy.err
