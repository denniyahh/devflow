# GSD run-scoped runtime state (session id, PID, timestamps — dead on any
# other checkout the moment it's written; regenerated at the next command).
# `.gsd/*/dispatch-isolation-sentinel.json` is documented as a "run-scoped
# sentinel" (gsd-core references/dispatch-isolation-gate.md, #3045).
# `.planning/milestone.lock` holds `{phase, session, pid, updated_at}` with a
# TTL-based advisory lock (gsd-core milestone-lock.cjs, #3311) — never meant
# to survive a commit. `.planning/state.json` is a best-effort derived
# projection republished at every step boundary (gsd-core state-contract.cjs,
# #3227), "no second answer to any question GSD already answers".
.gsd/
.planning/milestone.lock
.planning/state.json

# Planning, runtime states, and local databases

# DevFlow own state (dogfooding) — per-phase since the 14a refactor
.devflow/state.json
.devflow/state-*.json
.devflow/lock-*
.devflow/phase-*-stdout
.devflow/phase-*-stderr.log
.devflow/phase-*-exit
.devflow/phase-*-agent-pid
.devflow/last-ship*.json
.devflow/cron-instructions*.json
.devflow/events.jsonl
.devflow/gates/
.devflow/history/

# Git worktrees created by `devflow start --worktree` / `parallel` / `sequentagent`
.worktrees/

# Bytecode cache
__pycache__/

# Graphify knowledge graph — the portable payload (graph.json, manifest.json,
# .graphify_analysis.json) IS tracked on the personal workspace branch so the
# graph travels between machines. Everything below is deliberately not:
#   cache/                    tool-version-pinned AST cache (v0.9.53-s2); dead on upgrade
#   .graphify_root            absolute host path — wrong on any other checkout
#   .graphify_semantic_marker local token-count marker, no cross-machine meaning
#   .planning/graphs/         byte-identical duplicate of graphify-out/graph.json
graphify-out/cache/
graphify-out/.graphify_root
graphify-out/.graphify_semantic_marker
.planning/graphs/

# External-review raw traces (regenerable, hundreds of KB each)
.planning/phases/**/codex.err
.planning/phases/**/codex.clean
.planning/phases/**/agy.err
